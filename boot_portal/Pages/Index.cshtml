<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
<script>
    let fullServerPubKey = "";
    let winnersChartInstance = null;
    let onDeckChartInstance = null;
    let roundShareChartInstance = null;
    let roundHashrateChartInstance = null;
    let latestNetworkState = null;
    let globalRoundHistory = [];
    let globalHashrateSeries = { points: [], sampleIntervalSeconds: 60, localWindowSeconds: 1800 };
    let selectedRoundStateId = null;
    let roundHistoryOrder = localStorage.getItem("boot-round-history-order") || "oldest-left";
    let chartScaleMode = localStorage.getItem("boot-chart-scale-mode") || "linear";
    let hashrateWindow = localStorage.getItem("boot-hashrate-window") || "24h";
    let hashrateScaleMode = localStorage.getItem("boot-hashrate-scale-mode") || "linear";
    let currentRoundEstimateTimer = null;

    // Global state for client-side searching
    let globalWinnersList = [];
    let globalOnDeckList = [];
    let currentSearchTerm = "";
    const listViewModes = {
        "winners-list": "summary",
        "ondeck-list": "summary"
    };

    // --- INITIALIZE URL SEARCH ---
    // Checks if the URL is like /bc1q... and pre-fills the search
    window.addEventListener('DOMContentLoaded', () => {
        const path = window.location.pathname.substring(1); // Remove leading '/'
        // Simple check to ignore SignalR paths or empty paths
        if (path && path.length > 15 && !path.includes("/")) {
            const input = document.getElementById('search-input');
            input.value = path;
            currentSearchTerm = path; // Set immediate state
        }
    });

    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/poolStatsHub")
        .withAutomaticReconnect()
        .build();

    // --- SEARCH LOGIC ---
    function performSearch() {
        const input = document.getElementById('search-input');
        const rawTerm = input.value.trim();
        currentSearchTerm = rawTerm;
        const resultDiv = document.getElementById('search-results');

        if (!rawTerm) {
            resultDiv.innerHTML = "";
            refreshUI(); // Clear highlights
            return;
        }

        // 1. Scan Winners
        const winnerMatches = globalWinnersList
            .map((item, index) => ({item, index: index + 1})) // 1-based index
            .filter(x => normalizeSearchValue(x.item.username || x.item.address).includes(rawTerm.toLowerCase()));

        const winnerTotal = winnerMatches.reduce((sum, x) => sum + x.item.value, 0);

        // 2. Scan OnDeck
        const deckMatches = globalOnDeckList
            .map((item, index) => ({item, index: index + 1}))
            .filter(x => normalizeSearchValue(x.item.username || x.item.address).includes(rawTerm.toLowerCase()));

        const deckTotal = deckMatches.reduce((sum, x) => sum + x.item.value, 0);

        // 3. Build Output
        if (winnerMatches.length === 0 && deckMatches.length === 0) {
            resultDiv.innerHTML = `This address does not have any shares on the lists yet. Keep hashing!`;
        } else {
            let msg = "";
            if (deckMatches.length > 0) {
                const deckIndices = deckMatches.map(x => '#' + x.index).join(', ');
                const deckBtc = (deckTotal / 100000000.0).toFixed(8);
                msg += `<div><span class="result-highlight">On Deck List:</span> ${deckIndices}. Potential payout: ${deckBtc} BTC</div>`;
            }
            if (winnerMatches.length > 0) {
                const winIndices = winnerMatches.map(x => '#' + x.index).join(', ');
                const winBtc = (winnerTotal / 100000000.0).toFixed(8);
                msg += `<div><span class="result-highlight">Winners List:</span> ${winIndices}. Locked payout: ${winBtc} BTC</div>`;
            }
            resultDiv.innerHTML = msg;
        }

        // 4. Trigger UI Redraw to show highlights
        refreshUI();
    }

    function refreshUI() {
        updateTable("winners-list", globalWinnersList);
        updateTable("ondeck-list", globalOnDeckList);
        renderRoundHistory(globalRoundHistory);
        updateCurrentRoundTelemetry();
        updateHashrateHistoryChart();

        // Re-draw charts with the vertical lines
        winnersChartInstance = updateChart("winnersChart", globalWinnersList, "Winners List Depth", winnersChartInstance);
        onDeckChartInstance = updateChart("onDeckChart", globalOnDeckList, "On-Deck List Depth", onDeckChartInstance);
    }


    // --- STANDARD HELPERS ---
    function formatAddress(address) {
        if (!address) return "Unknown";
        const dotIndex = address.indexOf('.');
        let mainPart = address;
        let suffix = "";
        if (dotIndex !== -1) {
            mainPart = address.substring(0, dotIndex);
            suffix = address.substring(dotIndex);
        }
        if (mainPart.length <= 12) return address;
        const first6 = mainPart.substring(0, 6);
        const last6 = mainPart.substring(mainPart.length - 6);
        return `${first6}...${last6}${suffix}`;
    }

    function formatMinerLabel(value) {
        if (!value) return "Unknown";
        const text = String(value);
        const dotIndex = text.indexOf('.');
        const address = dotIndex === -1 ? text : text.substring(0, dotIndex);
        const worker = dotIndex === -1 ? "" : text.substring(dotIndex + 1);
        const shortAddress = address.length <= 6 ? address : address.substring(address.length - 6);
        const shortWorker = worker ? `.${worker.substring(0, 6)}` : "";
        return `${shortAddress}${shortWorker}`;
    }

    function formatBtcFromSats(value) {
        return ((value || 0) / 100000000.0).toFixed(8);
    }

    function formatPercent(part, total) {
        if (!total) return "0.0%";
        return `${((part / total) * 100).toFixed(1)}%`;
    }

    function formatElapsedSeconds(value) {
        if (value == null) return "--";
        const total = Math.max(0, Number(value));
        const hours = Math.floor(total / 3600);
        const minutes = Math.floor((total % 3600) / 60);
        const seconds = Math.floor(total % 60);

        if (hours > 0) return `${hours}h ${minutes}m ${seconds}s`;
        if (minutes > 0) return `${minutes}m ${seconds}s`;
        return `${seconds}s`;
    }

    function formatDiagnosticWindow(windowSeconds) {
        if (!windowSeconds || windowSeconds <= 0) return "--";
        const hours = windowSeconds / 3600;
        if (hours >= 24 && Number.isInteger(hours / 24)) return `${hours / 24}d`;
        if (Number.isInteger(hours)) return `${hours}h`;
        return formatElapsedSeconds(windowSeconds);
    }

    function formatAcceptanceRate(accepted, total) {
        if (!total) return "--";
        return `${((accepted / total) * 100).toFixed(1)}%`;
    }

    function renderLocalDatumDiagnostics() {
        const diagnostics = latestNetworkState?.localDatumDiagnostics || {};
        const reasons = Array.isArray(diagnostics.rejectionReasons) ? diagnostics.rejectionReasons : [];
        const totalSubmissions = diagnostics.totalSubmissions ?? 0;
        const acceptedCount = diagnostics.acceptedCount ?? 0;
        const onDeckCount = diagnostics.acceptedOnDeckCount ?? 0;
        const rejectedCount = diagnostics.rejectedCount ?? 0;

        document.getElementById("datum-diagnostic-window").innerText = formatDiagnosticWindow(diagnostics.windowSeconds);
        document.getElementById("datum-accepted-count").innerText = acceptedCount.toLocaleString();
        document.getElementById("datum-ondeck-count").innerText = onDeckCount.toLocaleString();
        document.getElementById("datum-rejected-count").innerText = rejectedCount.toLocaleString();
        document.getElementById("datum-acceptance-rate").innerText = formatAcceptanceRate(acceptedCount, totalSubmissions);

        const reasonText = reasons.length > 0
            ? `Top rejects: ${reasons.map(item => `${item.reason} (${item.count})`).join(", ")}`
            : "Top rejects: none";
        document.getElementById("datum-rejection-note").innerText = reasonText;
    }

    function estimateRankAdjustedHashrateThs(difficulties, elapsedSeconds) {
        if (!Array.isArray(difficulties) || difficulties.length === 0) return null;
        if (elapsedSeconds == null || elapsedSeconds <= 0) return null;

        const ranked = difficulties
            .map(value => Number(value) || 0)
            .filter(value => value > 0)
            .sort((a, b) => b - a);
        if (ranked.length === 0) return null;

        const estimates = ranked
            .map((difficulty, index) => ((index + 1) * difficulty * 4294967296) / elapsedSeconds / 1_000_000_000_000)
            .sort((a, b) => a - b);

        const middle = Math.floor(estimates.length / 2);
        if (estimates.length % 2 === 1) {
            return estimates[middle];
        }

        return (estimates[middle - 1] + estimates[middle]) / 2;
    }

    function formatHashrateFromThs(hashrateThs) {
        if (hashrateThs == null || !isFinite(hashrateThs) || hashrateThs <= 0) return "--";
        const hashesPerSecond = hashrateThs * 1_000_000_000_000;
        if (hashesPerSecond >= 1_000_000_000_000_000_000) return `${trimHashratePrecision(hashesPerSecond / 1_000_000_000_000_000_000)} EH/s`;
        if (hashesPerSecond >= 1_000_000_000_000_000) return `${trimHashratePrecision(hashesPerSecond / 1_000_000_000_000_000)} PH/s`;
        if (hashesPerSecond >= 1_000_000_000_000) return `${trimHashratePrecision(hashesPerSecond / 1_000_000_000_000)} TH/s`;
        if (hashesPerSecond >= 1_000_000_000) return `${trimHashratePrecision(hashesPerSecond / 1_000_000_000)} GH/s`;
        return `${hashesPerSecond.toFixed(0)} H/s`;
    }

    function trimHashratePrecision(value) {
        return value.toFixed(2).replace(/\.00$/, "").replace(/(\.\d)0$/, "$1");
    }

    function getCurrentRoundElapsedSeconds() {
        if (!latestNetworkState?.lastRotationUtc) {
            return latestNetworkState?.currentRoundElapsedSeconds ?? null;
        }

        const startedAt = new Date(latestNetworkState.lastRotationUtc).getTime();
        if (Number.isNaN(startedAt)) {
            return latestNetworkState?.currentRoundElapsedSeconds ?? null;
        }

        return Math.max(0, Math.floor((Date.now() - startedAt) / 1000));
    }

    function getCurrentRoundEstimatedHashrateThs() {
        const elapsedSeconds = getCurrentRoundElapsedSeconds();
        const difficulties = (globalOnDeckList || [])
            .map(item => Number(item.difficulty) || 0)
            .filter(value => value > 0);
        return estimateRankAdjustedHashrateThs(difficulties, elapsedSeconds);
    }

    function normalizeSearchValue(value) {
        return (value || "").toLowerCase();
    }

    function currentSearchValue() {
        return normalizeSearchValue(currentSearchTerm);
    }

    function formatTimestamp(value) {
        if (!value) return "--";
        return new Date(value).toLocaleString();
    }

    function formatBlockLabel(hash, height) {
        if (height != null) return `Block ${height.toLocaleString()}`;
        return `Block ${shortenHash(hash)}`;
    }

    function getBlockExplorerUrl(hash) {
        if (!hash) return null;
        return `https://mempool.space/block/${hash}`;
    }

    function describeRoundKind(kind) {
        if (!kind) return "round";
        if (kind.startsWith("test-trigger:")) return "test";
        if (kind === "manual-rotation") return "manual";
        if (kind === "manual-reset") return "manual";
        if (kind.startsWith("adopted-state:")) return "adopted";
        if (kind.startsWith("bootstrap-state:")) return "bootstrap";
        return kind.replace(/[:_]/g, " ");
    }

    function roundHistoryDisplayOrder(history) {
        if (roundHistoryOrder === "newest-left") {
            return [...history];
        }

        return [...history].reverse();
    }

    function setRoundHistoryOrder(order) {
        roundHistoryOrder = order === "newest-left" ? "newest-left" : "oldest-left";
        localStorage.setItem("boot-round-history-order", roundHistoryOrder);
        document.getElementById("rounds-oldest-left-btn").classList.toggle("active", roundHistoryOrder === "oldest-left");
        document.getElementById("rounds-newest-left-btn").classList.toggle("active", roundHistoryOrder === "newest-left");
        renderRoundHistory(globalRoundHistory);
    }

    function setChartScaleMode(mode) {
        chartScaleMode = mode === "log" ? "log" : "linear";
        localStorage.setItem("boot-chart-scale-mode", chartScaleMode);
        document.getElementById("chart-linear-btn").classList.toggle("active", chartScaleMode === "linear");
        document.getElementById("chart-log-btn").classList.toggle("active", chartScaleMode === "log");
        refreshUI();
    }

    async function setHashrateWindow(windowKey) {
        hashrateWindow = ["6h", "24h", "7d", "30d", "all"].includes(windowKey) ? windowKey : "24h";
        localStorage.setItem("boot-hashrate-window", hashrateWindow);
        ["6h", "24h", "7d", "30d", "all"].forEach(key => {
            document.getElementById(`hashrate-window-${key}-btn`).classList.toggle("active", hashrateWindow === key);
        });
        await loadHashrateSeries();
    }

    function setHashrateScaleMode(mode) {
        hashrateScaleMode = mode === "log" ? "log" : "linear";
        localStorage.setItem("boot-hashrate-scale-mode", hashrateScaleMode);
        document.getElementById("hashrate-scale-linear-btn").classList.toggle("active", hashrateScaleMode === "linear");
        document.getElementById("hashrate-scale-log-btn").classList.toggle("active", hashrateScaleMode === "log");
        updateHashrateHistoryChart();
    }

    async function loadHashrateSeries() {
        try {
            const response = await fetch(`/api/network/hashrate?window=${encodeURIComponent(hashrateWindow)}`);
            if (!response.ok) {
                throw new Error(`Hashrate series request failed with ${response.status}`);
            }

            globalHashrateSeries = await response.json();
            updateHashrateHistoryChart();
        } catch (error) {
            console.error(error);
            document.getElementById("round-hashrate-chart-note").innerText = "Failed to load sampled hashrate series.";
        }
    }

    function getHashrateWindowCutoff(windowKey) {
        const now = Date.now();
        switch (windowKey) {
            case "6h":
                return now - (6 * 60 * 60 * 1000);
            case "24h":
                return now - (24 * 60 * 60 * 1000);
            case "7d":
                return now - (7 * 24 * 60 * 60 * 1000);
            case "30d":
                return now - (30 * 24 * 60 * 60 * 1000);
            default:
                return null;
        }
    }

    function formatHashratePointLabel(timestampMs, isCurrentPoint) {
        if (isCurrentPoint) {
            return "Now";
        }

        const date = new Date(timestampMs);
        switch (hashrateWindow) {
            case "6h":
            case "24h":
                return date.toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" });
            case "7d":
            case "30d":
                return date.toLocaleDateString([], { month: "short", day: "numeric" });
            default:
                return `${date.toLocaleDateString([], { month: "short", day: "numeric" })} ${date.toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" })}`;
        }
    }

    function updateCurrentRoundTelemetry() {
        const elapsedSeconds = getCurrentRoundElapsedSeconds();
        const estimatedHashrateThs = getCurrentRoundEstimatedHashrateThs();
        const estimatedDisplay = formatHashrateFromThs(estimatedHashrateThs);
        const localDatumDisplay = formatHashrateFromThs(latestNetworkState?.localDatumHashrateThs);

        document.getElementById("current-round-age").innerText = formatElapsedSeconds(
            elapsedSeconds ?? latestNetworkState?.currentRoundElapsedSeconds
        );
        document.getElementById("current-round-hashrate").innerText =
            (estimatedDisplay !== "--" ? estimatedDisplay : null) ||
            latestNetworkState?.currentRoundObservedHashrateDisplay ||
            "--";
        document.getElementById("local-datum-hashrate").innerText =
            (localDatumDisplay !== "--" ? localDatumDisplay : null) ||
            latestNetworkState?.localDatumHashrateDisplay ||
            "--";
    }

    function updateHashrateHistoryChart() {
        const canvas = document.getElementById("roundHashrateChart");
        const note = document.getElementById("round-hashrate-chart-note");
        const ctx = canvas.getContext("2d");

        if (roundHashrateChartInstance) {
            roundHashrateChartInstance.destroy();
            roundHashrateChartInstance = null;
        }

        const points = [...(globalHashrateSeries?.points || [])]
            .filter(point => point && point.timestampUtc)
            .map(point => ({
                roundNumber: point.currentRoundNumber,
                timestampMs: new Date(point.timestampUtc).getTime(),
                label: `R${point.currentRoundNumber}`,
                teamHashrateThs: point.teamEstimatedHashrateThs,
                teamDisplay: point.teamEstimatedHashrateDisplay || formatHashrateFromThs(point.teamEstimatedHashrateThs),
                localHashrateThs: point.localDatumHashrateThs,
                localDisplay: point.localDatumHashrateDisplay || formatHashrateFromThs(point.localDatumHashrateThs)
            }));

        const currentHashrateThs = getCurrentRoundEstimatedHashrateThs();
        const currentLocalDatumHashrateThs = latestNetworkState?.localDatumHashrateThs ?? null;
        const currentTimestampMs = Date.now();
        if ((currentHashrateThs != null || currentLocalDatumHashrateThs != null)) {
            points.push({
                roundNumber: latestNetworkState?.currentRoundNumber,
                timestampMs: currentTimestampMs,
                label: `R${latestNetworkState?.currentRoundNumber ?? "?"}`,
                teamHashrateThs: currentHashrateThs,
                teamDisplay: formatHashrateFromThs(currentHashrateThs),
                localHashrateThs: currentLocalDatumHashrateThs,
                localDisplay: formatHashrateFromThs(currentLocalDatumHashrateThs),
                isCurrent: true
            });
        }

        if (points.length === 0) {
            note.innerText = "Not enough completed round data yet for a hashrate timeline.";
            return;
        }

        const labels = points.map(point => formatHashratePointLabel(point.timestampMs, !!point.isCurrent));
        const teamData = points.map(point => point.teamHashrateThs);
        const localData = points.map(point => point.localHashrateThs);
        const positiveValues = [...teamData, ...localData]
            .map(value => Number(value) || 0)
            .filter(value => value > 0);
        const hasPositiveValues = positiveValues.length > 0;
        const positiveMin = hasPositiveValues ? Math.min(...positiveValues) : null;
        const useLogScale = hashrateScaleMode === "log" && hasPositiveValues;
        const accentColor = getComputedStyle(document.documentElement).getPropertyValue('--accent-color').trim();
        const secondaryColor = "#39d98a";

        roundHashrateChartInstance = new Chart(ctx, {
            type: "line",
            data: {
                labels: labels,
                datasets: [{
                    label: "Team Estimate",
                    data: teamData,
                    borderColor: accentColor,
                    backgroundColor: `${accentColor}33`,
                    borderWidth: 2,
                    pointRadius: points.map(point => point.isCurrent ? 5 : 3),
                    pointHoverRadius: points.map(point => point.isCurrent ? 7 : 5),
                    fill: true,
                    tension: 0.25
                },
                {
                    label: "Local DATUM Estimate",
                    data: localData,
                    borderColor: secondaryColor,
                    backgroundColor: `${secondaryColor}22`,
                    borderWidth: 2,
                    pointRadius: points.map(point => point.isCurrent ? 4 : 2),
                    pointHoverRadius: points.map(point => point.isCurrent ? 6 : 4),
                    fill: false,
                    tension: 0.2
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: true,
                        position: "bottom",
                        labels: { color: "#888" }
                    },
                    title: {
                        display: true,
                        text: "Sampled Team / Local DATUM Hashrate",
                        color: "#888"
                    },
                    tooltip: {
                        callbacks: {
                            title: function(context) {
                                const point = points[context[0].dataIndex];
                                return `${point.label} · ${new Date(point.timestampMs).toLocaleString()}`;
                            },
                            label: function(context) {
                                const point = points[context.dataIndex];
                                return context.datasetIndex === 0
                                    ? `Team: ${point.teamDisplay}`
                                    : `Local DATUM: ${point.localDisplay}`;
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        ticks: { color: "#888", maxRotation: 0, autoSkip: true },
                        grid: { display: false }
                    },
                    y: {
                        type: useLogScale ? "logarithmic" : "linear",
                        beginAtZero: !useLogScale,
                        min: useLogScale && positiveMin != null ? Math.max(positiveMin * 0.8, positiveMin / 1.5) : undefined,
                        ticks: {
                            color: "#888",
                            callback: function(value) {
                                return formatHashrateFromThs(value);
                            }
                        },
                        grid: { color: "#333", drawBorder: false }
                    }
                }
            }
        });

        const currentPoint = points[points.length - 1];
        const historyOnlyPoints = points.filter(point => !point.isCurrent && point.teamHashrateThs != null);
        const averageHashrateThs = historyOnlyPoints.length > 0
            ? historyOnlyPoints.reduce((sum, point) => sum + point.teamHashrateThs, 0) / historyOnlyPoints.length
            : null;
        const localWindowMinutes = Math.round((globalHashrateSeries?.localWindowSeconds || 1800) / 60);
        const scaleText = hashrateScaleMode === "log" ? "Log scale emphasizes relative swings and prevents one lucky spike from flattening the rest of the series." : "Linear scale shows absolute swings in estimated hashrate.";
        note.innerText = currentPoint?.isCurrent && averageHashrateThs != null
            ? `Live team point updates every second from the current On Deck list. Local DATUM estimate uses a rolling ${localWindowMinutes}-minute window. Team window average: ${formatHashrateFromThs(averageHashrateThs)}. ${scaleText}`
            : `Local DATUM estimate uses a rolling ${localWindowMinutes}-minute window of directly connected DATUM shares. ${scaleText}`;
    }

    function recipientMatchesSearch(item) {
        const term = currentSearchValue();
        if (!term) return false;
        const address = normalizeSearchValue(item.address);
        const username = normalizeSearchValue(item.username);
        return address.includes(term) || username.includes(term);
    }

    function computeRecipientShare(recipients, totalValue) {
        if (!currentSearchValue()) return null;
        const matchingValue = (recipients || [])
            .filter(recipientMatchesSearch)
            .reduce((sum, item) => sum + (item.totalValue || 0), 0);
        return {
            value: matchingValue,
            percent: totalValue ? (matchingValue / totalValue) * 100 : 0
        };
    }

    function buildRoundPreview(recipients, totalValue) {
        if (!recipients || recipients.length === 0) return "No payouts";
        return recipients.slice(0, 3).map(entry => {
            const label = formatMinerLabel(entry.username || entry.address);
            return `${label} ${formatPercent(entry.totalValue, totalValue)}`;
        }).join(" · ");
    }

    function describeRoundStatus(entry) {
        return entry.isOrphaned ? "orphaned" : "canonical";
    }

    function renderRoundHistory(history) {
        const note = document.getElementById("round-history-note");
        const scroller = document.getElementById("round-history-scroller");
        const detail = document.getElementById("round-history-detail");
        scroller.innerHTML = "";
        document.getElementById("rounds-oldest-left-btn").classList.toggle("active", roundHistoryOrder === "oldest-left");
        document.getElementById("rounds-newest-left-btn").classList.toggle("active", roundHistoryOrder === "newest-left");

        if (!history || history.length === 0) {
            note.innerText = "No completed rounds recorded yet.";
            detail.innerHTML = '<div class="round-history-empty">Completed rounds will appear here after the next lock.</div>';
            updateRoundShareChart([]);
            selectedRoundStateId = null;
            return;
        }

        const orphanedCount = history.filter(entry => entry.isOrphaned).length;
        note.innerText = `Showing the most recent ${history.length} completed rounds (${orphanedCount} orphaned). Order is ${roundHistoryOrder === "oldest-left" ? "oldest to newest" : "newest to oldest"}.`;

        if (!selectedRoundStateId || !history.some(entry => entry.stateId === selectedRoundStateId)) {
            selectedRoundStateId = history[0].stateId;
        }

        const displayHistory = roundHistoryDisplayOrder(history);
        displayHistory.forEach((entry) => {
            const card = document.createElement("button");
            card.type = "button";
            card.className = `round-card${entry.isOrphaned ? " orphaned" : ""}${entry.stateId === selectedRoundStateId ? " active" : ""}`;
            card.onclick = () => {
                selectedRoundStateId = entry.stateId;
                renderRoundHistory(globalRoundHistory);
            };

            const explorerUrl = getBlockExplorerUrl(entry.triggerBlockHash);
            card.innerHTML = `
                <div class="round-card-header">
                    <div class="round-card-title">Round ${entry.roundNumber}</div>
                    <div class="round-kind-pill${entry.isOrphaned ? " orphaned" : ""}">${entry.isOrphaned ? "orphan" : describeRoundKind(entry.kind)}</div>
                </div>
                <div class="round-card-meta">${formatBlockLabel(entry.triggerBlockHash, entry.triggerBlockHeight)}</div>
                <div class="round-card-meta">${formatTimestamp(entry.lockedAtUtc)}</div>
                <div class="round-card-meta">${describeRoundStatus(entry)}</div>
                ${explorerUrl ? `<div class="round-card-meta"><a class="round-card-link" href="${explorerUrl}" target="_blank" rel="noopener noreferrer" onclick="event.stopPropagation()">Open Block</a></div>` : ""}
                <div class="round-card-preview"><strong>Paid:</strong> ${buildRoundPreview(entry.paidRecipients, entry.paidTotalValue)}</div>
                <div class="round-card-preview"><strong>Next:</strong> ${buildRoundPreview(entry.nextRecipients, entry.nextWinnerTotalValue)}</div>
            `;
            scroller.appendChild(card);
        });

        const selected = history.find(entry => entry.stateId === selectedRoundStateId) || history[0];
        renderRoundHistoryDetail(selected, detail);
        updateRoundShareChart(history);
    }

