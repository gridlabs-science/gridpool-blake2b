@page "{addr?}"
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>BOOT PROTOCOL</title>
    <link href="https://fonts.googleapis.com/css2?family=Roboto+Mono:wght@400;500;700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        :root {
            --bg-color: #111111;
            --text-color: #eeeeee;
            --text-muted: #888888;
            --accent-color: #bd59ff;
            --highlight-color: #ffffff; /* Bright white for search matches */
            --border-color: #333333;
            --container-width: 1500px;
        }

        body {
            font-family: 'Roboto Mono', monospace;
            background-color: var(--bg-color);
            color: var(--text-color);
            margin: 0;
            padding: 0; /* Removed padding for banner */
            line-height: 1.4;
        }

        /* --- DEV BANNER --- */
        .dev-banner {
            background: repeating-linear-gradient(
                45deg,
                #d4af37,
                #d4af37 10px,
                #bfa030 10px,
                #bfa030 20px
            );
            color: #000;
            text-align: center;
            font-weight: bold;
            padding: 5px;
            font-size: 0.8rem;
            border-bottom: 2px solid #000;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        /* --- LOGO STYLING --- */
        .logo-img {
            position: absolute;
            top: 45px; /* Adjusted for banner */
            left: 30px;
            width: 160px;
            height: auto;
            opacity: 0.9;
            transition: opacity 0.3s;
        }

        .logo-img:hover {
            opacity: 1;
        }

        /* Main Layout */
        .main-container {
            max-width: var(--container-width);
            margin: 0 auto;
            padding: 40px 20px 20px 20px;
        }

        /* Typography */
        h1, h2, h3 {
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 1rem;
            font-weight: 700;
        }

        h1 {
            color: var(--accent-color);
            text-align: center;
            margin-top: 0;
        }

        h2 {
            font-size: 1.2rem;
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 5px;
            margin-top: 30px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        a {
            color: var(--accent-color);
            text-decoration: none;
            cursor: pointer;
        }

        a:hover {
            text-decoration: underline;
        }

        /* --- TOOLTIPS (INFO ICONS) --- */
        .info-icon {
            display: inline-block;
            width: 18px;
            height: 18px;
            border: 1px solid var(--text-muted);
            border-radius: 50%;
            text-align: center;
            line-height: 16px;
            font-size: 12px;
            color: var(--text-muted);
            cursor: help;
            position: relative;
        }

        .info-icon:hover::after {
            content: attr(data-tooltip);
            position: absolute;
            bottom: 125%;
            left: 50%;
            transform: translateX(-50%);
            background: #333;
            color: #fff;
            padding: 8px;
            border-radius: 4px;
            font-size: 12px;
            width: 200px;
            text-transform: none;
            font-weight: normal;
            z-index: 10;
            border: 1px solid var(--accent-color);
        }

        /* Search Section */
        .search-section {
            margin-bottom: 40px;
            text-align: center;
        }

        .search-box-container {
            display: inline-flex;
            border: 1px solid var(--border-color);
            padding: 5px;
            background: #000;
        }

        .search-input {
            background: transparent;
            border: none;
            color: var(--text-color);
            font-family: inherit;
            padding: 8px;
            width: 300px;
            outline: none;
        }

        .search-btn {
            background: var(--accent-color);
            border: none;
            color: #000;
            font-family: inherit;
            padding: 8px 15px;
            font-weight: bold;
            cursor: pointer;
        }

        .search-btn:hover {
            opacity: 0.9;
        }

        /* Search Results Text */
        .search-results {
            margin-top: 15px;
            min-height: 20px;
            font-size: 0.9rem;
            color: var(--text-muted);
        }

        .result-highlight {
            color: var(--highlight-color);
            font-weight: bold;
        }

        /* Info Grids */
        .info-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .info-box {
            border: 1px solid var(--border-color);
            padding: 15px;
        }

        .info-box h3 {
            font-size: 0.9rem;
            color: var(--text-muted);
            margin: 0 0 10px 0;
        }

        .info-value {
            font-size: 1.1rem;
            word-break: break-all;
        }

        .accent-value {
            color: var(--accent-color);
        }

        .key-container {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: #000;
            padding: 5px;
            font-size: 0.85rem;
            border: 1px solid var(--border-color);
        }

        .copy-btn {
            background: transparent;
            border: none;
            color: var(--text-muted);
            cursor: pointer;
        }

        .copy-btn:hover {
            color: var(--accent-color);
        }

        /* Charts */
        .charts-section {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 30px;
        }

        .section-toolbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            flex-wrap: wrap;
            margin-top: 30px;
            margin-bottom: 12px;
        }

        .section-toolbar h2 {
            margin: 0;
        }

        .chart-container {
            border: 1px solid var(--border-color);
            padding: 15px;
            height: 250px;
        }

        .round-history-note {
            color: var(--text-muted);
            font-size: 0.85rem;
            margin-bottom: 10px;
        }

        .round-history-toolbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 10px;
            flex-wrap: wrap;
        }

        .round-history-scroller {
            display: flex;
            gap: 12px;
            overflow-x: auto;
            padding-bottom: 8px;
            margin-bottom: 16px;
        }

        .round-card {
            border: 1px solid var(--border-color);
            background: #0c0c0c;
            padding: 12px;
            cursor: pointer;
            min-height: 128px;
            flex: 1 0 clamp(220px, 20vw, 340px);
            max-width: 360px;
            color: var(--text-color);
            font-family: inherit;
            text-align: left;
            appearance: none;
        }

        .round-card:hover {
            border-color: var(--text-muted);
        }

        .round-card.active {
            border-color: var(--accent-color);
            box-shadow: inset 0 0 0 1px var(--accent-color);
        }

        .round-card.orphaned {
            opacity: 0.6;
            border-style: dashed;
        }

        .round-card.orphaned.active {
            opacity: 0.8;
        }

        .round-card-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            margin-bottom: 10px;
        }

        .round-card-title {
            font-weight: bold;
            color: var(--text-color);
        }

        .round-card-link {
            color: var(--accent-color);
            font-size: 0.76rem;
            text-decoration: none;
        }

        .round-card-link:hover {
            text-decoration: underline;
        }

        .round-kind-pill {
            font-size: 0.72rem;
            border: 1px solid var(--border-color);
            color: var(--accent-color);
            padding: 2px 6px;
            text-transform: uppercase;
        }

        .round-kind-pill.orphaned {
            color: #ff9f1c;
            border-color: #ff9f1c;
        }

        .round-card-meta,
        .round-card-preview {
            font-size: 0.8rem;
            color: var(--text-muted);
            margin-bottom: 6px;
        }

        .round-card-preview strong {
            color: var(--text-color);
        }

        .round-detail {
            border: 1px solid var(--border-color);
            padding: 16px;
            background: #0c0c0c;
        }

        .round-detail-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 12px;
            margin-bottom: 18px;
        }

        .round-detail-box {
            border: 1px solid var(--border-color);
            padding: 12px;
            background: #111;
        }

        .round-detail-box h3 {
            margin: 0 0 8px 0;
            font-size: 0.78rem;
            color: var(--text-muted);
        }

        .round-detail-value {
            font-size: 0.95rem;
            word-break: break-word;
        }

        .round-detail-columns {
            display: grid;
            grid-template-columns: 1fr;
            gap: 20px;
        }

        .round-detail-section h3 {
            margin: 0 0 10px 0;
        }

        .round-detail-head {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 18px;
            flex-wrap: wrap;
        }

        .round-detail-head h3 {
            margin: 0 0 6px 0;
        }

        .round-detail-subline {
            color: var(--text-muted);
            font-size: 0.85rem;
            word-break: break-word;
        }

        .round-detail-warning {
            color: #ff9f1c;
            border: 1px dashed #ff9f1c;
            padding: 10px 12px;
            margin-bottom: 16px;
            font-size: 0.85rem;
            background: rgba(255, 159, 28, 0.08);
        }

        .round-history-chart {
            margin-top: 16px;
        }

        .round-history-chart-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
            gap: 16px;
            margin-top: 16px;
        }

        .round-history-chart-toolbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 12px;
            flex-wrap: wrap;
        }

        .round-history-chart-toolbar h3 {
            margin: 0;
            font-size: 0.95rem;
            color: var(--text-muted);
        }

        .round-history-chart canvas {
            width: 100%;
            height: 220px;
        }

        .round-history-search-note {
            color: var(--accent-color);
            font-size: 0.85rem;
            margin-top: 8px;
        }

        .round-history-empty {
            color: var(--text-muted);
            border: 1px dashed var(--border-color);
            padding: 16px;
            text-align: center;
        }

        /* Tables */
        .table-container {
            overflow-x: auto;
        }

        .list-toolbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin: -6px 0 10px 0;
            color: var(--text-muted);
            font-size: 0.85rem;
        }

        .list-summary-note {
            min-height: 1em;
        }

        .view-toggle {
            display: inline-flex;
            border: 1px solid var(--border-color);
            background: #000;
        }

        .toggle-btn {
            background: transparent;
            border: none;
            color: var(--text-muted);
            font-family: inherit;
            padding: 6px 10px;
            cursor: pointer;
        }

        .toggle-btn.active {
            background: var(--accent-color);
            color: #000;
            font-weight: bold;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
        }

        #winners-list,
        #ondeck-list {
            table-layout: fixed;
        }

        #winners-list th:first-child,
        #winners-list td:first-child,
        #ondeck-list th:first-child,
        #ondeck-list td:first-child {
            width: 8.5rem;
        }

        .compact-label {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        th {
            color: var(--text-muted);
            font-weight: normal;
            padding: 10px 5px;
            border-bottom: 1px solid var(--border-color);
        }

        td {
            padding: 10px 5px;
            border-bottom: 1px solid #222;
        }

        tr:hover td {
            background-color: #1a1a1a;
        }

        .static-row td {
            color: var(--accent-color);
            font-style: italic;
        }

        /* Search Highlight Row Style */
        tr.highlight-row td {
            background-color: rgba(189, 89, 255, 0.2);
            color: var(--highlight-color);
            font-weight: bold;
            border-bottom: 1px solid var(--highlight-color);
        }

        .omitted-row td {
            color: var(--text-muted);
            text-align: center;
            font-style: italic;
        }

        /* Footer */
        footer {
            margin-top: 50px;
            text-align: center;
            font-size: 0.9rem;
            color: var(--text-muted);
        }

        footer a {
            margin: 0 10px;
        }

        /* Modals */
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.8);
            z-index: 2000;
            justify-content: center;
            align-items: center;
        }

        .modal-content {
            background: var(--bg-color);
            border: 2px solid var(--accent-color);
            padding: 30px;
            max-width: 600px;
            width: 90%;
            max-height: 80vh;
            overflow-y: auto;
            position: relative;
        }

        .close-modal {
            position: absolute;
            top: 10px;
            right: 15px;
            font-size: 1.5rem;
            color: var(--accent-color);
            cursor: pointer;
        }

        /* --- RESPONSIVE --- */
        @@media (max-width: 1100px) {
            .logo-img {
                position: relative;
                display: block;
                margin: 0 auto 20px auto;
                top: 0;
                left: 0;
            }

            .charts-section {
                grid-template-columns: 1fr;
            }

            .round-detail-columns {
                grid-template-columns: 1fr;
            }

            .round-history-toolbar {
                align-items: flex-start;
            }

            .round-history-chart-grid {
                grid-template-columns: 1fr;
            }

            .list-toolbar {
                flex-direction: column;
                align-items: flex-start;
            }
        }
    </style>
</head>
<body>

<div class="dev-banner">
    ⚠️ DEVELOPER PREVIEW: EXPECT FREQUENT SERVER REBOOTS AND COPIUS BUGS ⚠️
</div>

<img src="logo.png" alt="Grid Labs" class="logo-img"/>

<div class="main-container">
    <h1>BOOT PROTOCOL</h1>

    <div class="search-section">
        <div class="search-box-container">
            <input type="text" id="search-input" class="search-input" placeholder="Enter Wallet Address..."
                   onkeypress="if(event.key === 'Enter') performSearch()">
            <button class="search-btn" onclick="performSearch()">SEARCH</button>
        </div>
        <div id="search-results" class="search-results"></div>
    </div>

    <div class="info-grid">
        <div class="info-box">
            <h3>🏆 All-Time Best Diff</h3>
            <div class="info-value accent-value" id="record-diff">0</div>
            <h3>Miner</h3>
            <div class="info-value" id="record-miner">None</div>
            <h3>Time (UTC)</h3>
            <div class="info-value" id="record-time">--</div>
        </div>

        <div class="info-box">
            <h3>📡 Connection Info</h3>
            <div>Host: <span class="accent-value" id="server-host">Loading...</span></div>
            <div>Port: <span class="accent-value" id="server-port">Loading...</span></div>
            <h3 style="margin-top: 10px;">Pool Pubkey</h3>
            <div class="key-container">
                <span id="server-pubkey-display">Loading...</span>
                <button onclick="copyPubKey()" class="copy-btn" title="Copy Key">📋</button>
            </div>
            <div id="copy-feedback" style="color: var(--accent-color); height: 15px; font-size: 0.7em;"></div>
        </div>

        <div class="info-box">
            <h3>🕸 Network State</h3>
            <div>Self: <span class="accent-value" id="self-endpoint">--</span></div>
            <div>Network: <span class="accent-value" id="network-id">Loading...</span></div>
            <div>Current Round: <span class="accent-value" id="current-round-number">--</span></div>
            <div>Template Slots: <span class="accent-value" id="template-slot-count">Loading...</span></div>
            <div>Peers: <span class="accent-value" id="peer-count">0</span></div>
            <div>Current State: <span class="accent-value" id="current-state-id">Loading...</span></div>
            <div>Candidate State: <span class="accent-value" id="candidate-state-id">Loading...</span></div>
            <div>Round Age: <span class="accent-value" id="current-round-age">--</span></div>
            <div>Estimated Hashrate: <span class="accent-value" id="current-round-hashrate">--</span></div>
            <div>Local DATUM Hashrate: <span class="accent-value" id="local-datum-hashrate">--</span></div>
            <h3 style="margin-top: 10px;">Local DATUM Diagnostics</h3>
            <div>Window: <span class="accent-value" id="datum-diagnostic-window">--</span></div>
            <div>Accepted: <span class="accent-value" id="datum-accepted-count">--</span></div>
            <div>On Deck: <span class="accent-value" id="datum-ondeck-count">--</span></div>
            <div>Rejected: <span class="accent-value" id="datum-rejected-count">--</span></div>
            <div>Acceptance: <span class="accent-value" id="datum-acceptance-rate">--</span></div>
            <div>Test Trigger: <span class="accent-value" id="testing-trigger-status">Loading...</span></div>
            <div>Last Test Block: <span class="accent-value" id="last-testing-trigger-block">--</span></div>
            <h3 style="margin-top: 10px;">Commitment Preview</h3>
            <div class="info-value" id="commitment-preview">Loading...</div>
            <div class="search-results" id="commitment-note"></div>
            <div class="search-results" id="testing-trigger-note"></div>
            <div class="search-results" id="round-hashrate-note">Team estimate uses the median rank-adjusted current On Deck share set. Local DATUM estimate uses a rolling window of directly connected DATUM shares.</div>
            <div class="search-results" id="datum-rejection-note"></div>
        </div>
    </div>

    <div class="section-toolbar">
        <h2>Difficulty Distribution</h2>
        <div class="view-toggle">
            <button class="toggle-btn active" id="chart-linear-btn" onclick="setChartScaleMode('linear')">LINEAR</button>
            <button class="toggle-btn" id="chart-log-btn" onclick="setChartScaleMode('log')">LOG</button>
        </div>
    </div>
    <div class="charts-section">
        <div class="chart-container">
            <canvas id="winnersChart"></canvas>
        </div>
        <div class="chart-container">
            <canvas id="onDeckChart"></canvas>
        </div>
    </div>

    <section>
        <h2>
            Peer Status
            <span class="info-icon"
                  data-tooltip="configured: manually seeded peer. discovered: learned from another peer. connected: recent summary poll succeeded. share: peer submitted a share to this node. relayed: this node recently relayed a share to that peer. empty/error/foreign-network: recent peer sync failed or was incompatible.">i</span>
        </h2>
        <div class="table-container">
            <table id="peer-list">
                <thead>
                <tr>
                    <th>Endpoint</th>
                    <th>Status</th>
                    <th>Latency</th>
                    <th>Last Seen</th>
                </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </section>

    <section style="margin-top: 30px;">
        <h2>Round History</h2>
        <div class="round-history-toolbar">
            <div class="round-history-note" id="round-history-note">Loading round history...</div>
            <div class="view-toggle">
                <button class="toggle-btn active" id="rounds-oldest-left-btn" onclick="setRoundHistoryOrder('oldest-left')">OLD LEFT</button>
                <button class="toggle-btn" id="rounds-newest-left-btn" onclick="setRoundHistoryOrder('newest-left')">NEW LEFT</button>
            </div>
        </div>
        <div class="round-history-scroller" id="round-history-scroller"></div>
        <div class="round-detail" id="round-history-detail">
            <div class="round-history-empty">No completed rounds recorded yet.</div>
        </div>
        <div class="round-history-chart-grid">
            <div class="chart-container round-history-chart">
                <canvas id="roundShareChart"></canvas>
                <div class="round-history-search-note" id="round-history-search-note"></div>
            </div>
            <div class="chart-container round-history-chart">
                <div class="round-history-chart-toolbar">
                    <h3>Estimated Hashrate Through Time</h3>
                    <div class="view-toggle">
                        <button class="toggle-btn" id="hashrate-window-6h-btn" onclick="setHashrateWindow('6h')">6H</button>
                        <button class="toggle-btn active" id="hashrate-window-24h-btn" onclick="setHashrateWindow('24h')">24H</button>
                        <button class="toggle-btn" id="hashrate-window-7d-btn" onclick="setHashrateWindow('7d')">7D</button>
                        <button class="toggle-btn" id="hashrate-window-30d-btn" onclick="setHashrateWindow('30d')">30D</button>
                        <button class="toggle-btn" id="hashrate-window-all-btn" onclick="setHashrateWindow('all')">ALL</button>
                    </div>
                    <div class="view-toggle">
                        <button class="toggle-btn active" id="hashrate-scale-linear-btn" onclick="setHashrateScaleMode('linear')">LINEAR</button>
                        <button class="toggle-btn" id="hashrate-scale-log-btn" onclick="setHashrateScaleMode('log')">LOG</button>
                    </div>
                </div>
                <canvas id="roundHashrateChart"></canvas>
                <div class="round-history-search-note" id="round-hashrate-chart-note"></div>
            </div>
        </div>
    </section>

    <div class="lists-container">
        <section>
            <h2>
                Current Winners List
                <span class="info-icon"
                      data-tooltip="High difficulty shares that won the last round.  Miners put these payouts in their coinbase transaction (including one spot for their own) to compete in the current round.">i</span>
            </h2>
            <div class="list-toolbar">
                <div class="list-summary-note" id="winners-summary-note"></div>
                <div class="view-toggle">
                    <button class="toggle-btn active" id="winners-summary-btn" onclick="setListViewMode('winners-list', 'summary')">SUMMARY</button>
                    <button class="toggle-btn" id="winners-full-btn" onclick="setListViewMode('winners-list', 'full')">FULL</button>
                </div>
            </div>
            <div class="table-container">
                <table id="winners-list">
                    <thead>
                    <tr>
                        <th>Address</th>
                        <th>Value (BTC)</th>
                        <th>Difficulty</th>
                    </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </section>

        <section style="margin-top: 30px;">
            <h2>
                On-Deck List
                <span class="info-icon"
                      data-tooltip="The current round of competition. When the team finds a new block, these addresses get locked into the Winners List.">i</span>
            </h2>
            <div class="list-toolbar">
                <div class="list-summary-note" id="ondeck-summary-note"></div>
                <div class="view-toggle">
