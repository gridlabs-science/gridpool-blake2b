@page "{addr?}"
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>BOOT PROTOCOL</title>
    <link href="https://fonts.googleapis.com/css2?family=Roboto+Mono:wght@400;500;700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        :root {
            --bg-color: #111111;
            --text-color: #eeeeee;
            --text-muted: #888888;
            --accent-color: #bd59ff;
            --highlight-color: #ffffff; /* Bright white for search matches */
            --border-color: #333333;
            --container-width: 900px;
        }

        body {
            font-family: 'Roboto Mono', monospace;
            background-color: var(--bg-color);
            color: var(--text-color);
            margin: 0;
            padding: 0; /* Removed padding for banner */
            line-height: 1.4;
        }

        /* --- DEV BANNER --- */
        .dev-banner {
            background: repeating-linear-gradient(
                45deg,
                #d4af37,
                #d4af37 10px,
                #bfa030 10px,
                #bfa030 20px
            );
            color: #000;
            text-align: center;
            font-weight: bold;
            padding: 5px;
            font-size: 0.8rem;
            border-bottom: 2px solid #000;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        /* --- LOGO STYLING --- */
        .logo-img {
            position: absolute;
            top: 45px; /* Adjusted for banner */
            left: 30px;
            width: 160px;
            height: auto;
            opacity: 0.9;
            transition: opacity 0.3s;
        }

        .logo-img:hover {
            opacity: 1;
        }

        /* Main Layout */
        .main-container {
            max-width: var(--container-width);
            margin: 0 auto;
            padding: 40px 20px 20px 20px;
        }

        /* Typography */
        h1, h2, h3 {
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 1rem;
            font-weight: 700;
        }

        h1 {
            color: var(--accent-color);
            text-align: center;
            margin-top: 0;
        }

        h2 {
            font-size: 1.2rem;
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 5px;
            margin-top: 30px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        a {
            color: var(--accent-color);
            text-decoration: none;
            cursor: pointer;
        }

        a:hover {
            text-decoration: underline;
        }

        /* --- TOOLTIPS (INFO ICONS) --- */
        .info-icon {
            display: inline-block;
            width: 18px;
            height: 18px;
            border: 1px solid var(--text-muted);
            border-radius: 50%;
            text-align: center;
            line-height: 16px;
            font-size: 12px;
            color: var(--text-muted);
            cursor: help;
            position: relative;
        }

        .info-icon:hover::after {
            content: attr(data-tooltip);
            position: absolute;
            bottom: 125%;
            left: 50%;
            transform: translateX(-50%);
            background: #333;
            color: #fff;
            padding: 8px;
            border-radius: 4px;
            font-size: 12px;
            width: 200px;
            text-transform: none;
            font-weight: normal;
            z-index: 10;
            border: 1px solid var(--accent-color);
        }

        /* Search Section */
        .search-section {
            margin-bottom: 40px;
            text-align: center;
        }

        .search-box-container {
            display: inline-flex;
            border: 1px solid var(--border-color);
            padding: 5px;
            background: #000;
        }

        .search-input {
            background: transparent;
            border: none;
            color: var(--text-color);
            font-family: inherit;
            padding: 8px;
            width: 300px;
            outline: none;
        }

        .search-btn {
            background: var(--accent-color);
            border: none;
            color: #000;
            font-family: inherit;
            padding: 8px 15px;
            font-weight: bold;
            cursor: pointer;
        }

        .search-btn:hover {
            opacity: 0.9;
        }

        /* Search Results Text */
        .search-results {
            margin-top: 15px;
            min-height: 20px;
            font-size: 0.9rem;
            color: var(--text-muted);
        }

        .result-highlight {
            color: var(--highlight-color);
            font-weight: bold;
        }

        /* Info Grids */
        .info-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .info-box {
            border: 1px solid var(--border-color);
            padding: 15px;
        }

        .info-box h3 {
            font-size: 0.9rem;
            color: var(--text-muted);
            margin: 0 0 10px 0;
        }

        .info-value {
            font-size: 1.1rem;
            word-break: break-all;
        }

        .accent-value {
            color: var(--accent-color);
        }

        .key-container {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: #000;
            padding: 5px;
            font-size: 0.85rem;
            border: 1px solid var(--border-color);
        }

        .copy-btn {
            background: transparent;
            border: none;
            color: var(--text-muted);
            cursor: pointer;
        }

        .copy-btn:hover {
            color: var(--accent-color);
        }

        /* Charts */
        .charts-section {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 30px;
        }

        .chart-container {
            border: 1px solid var(--border-color);
            padding: 15px;
            height: 250px;
        }

        .round-history-note {
            color: var(--text-muted);
            font-size: 0.85rem;
            margin-bottom: 10px;
        }

        .round-history-toolbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 10px;
            flex-wrap: wrap;
        }

        .round-history-scroller {
            display: grid;
            grid-auto-flow: column;
            grid-auto-columns: minmax(180px, 220px);
            gap: 12px;
            overflow-x: auto;
            padding-bottom: 8px;
            margin-bottom: 16px;
        }

        .round-card {
            border: 1px solid var(--border-color);
            background: #0c0c0c;
            padding: 12px;
            cursor: pointer;
            min-height: 128px;
            color: var(--text-color);
            font-family: inherit;
            text-align: left;
            appearance: none;
        }

        .round-card:hover {
            border-color: var(--text-muted);
        }

        .round-card.active {
            border-color: var(--accent-color);
            box-shadow: inset 0 0 0 1px var(--accent-color);
        }

        .round-card-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            margin-bottom: 10px;
        }

        .round-card-title {
            font-weight: bold;
            color: var(--text-color);
        }

        .round-card-link {
            color: var(--accent-color);
            font-size: 0.76rem;
            text-decoration: none;
        }

        .round-card-link:hover {
            text-decoration: underline;
        }

        .round-kind-pill {
            font-size: 0.72rem;
            border: 1px solid var(--border-color);
            color: var(--accent-color);
            padding: 2px 6px;
            text-transform: uppercase;
        }

        .round-card-meta,
        .round-card-preview {
            font-size: 0.8rem;
            color: var(--text-muted);
            margin-bottom: 6px;
        }

        .round-card-preview strong {
            color: var(--text-color);
        }

        .round-detail {
            border: 1px solid var(--border-color);
            padding: 16px;
            background: #0c0c0c;
        }

        .round-detail-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 12px;
            margin-bottom: 18px;
        }

        .round-detail-box {
            border: 1px solid var(--border-color);
            padding: 12px;
            background: #111;
        }

        .round-detail-box h3 {
            margin: 0 0 8px 0;
            font-size: 0.78rem;
            color: var(--text-muted);
        }

        .round-detail-value {
            font-size: 0.95rem;
            word-break: break-word;
        }

        .round-detail-columns {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
        }

        .round-detail-head {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 18px;
            flex-wrap: wrap;
        }

        .round-detail-head h3 {
            margin: 0 0 6px 0;
        }

        .round-detail-subline {
            color: var(--text-muted);
            font-size: 0.85rem;
            word-break: break-word;
        }

        .round-history-chart {
            margin-top: 16px;
        }

        .round-history-chart canvas {
            width: 100%;
            height: 220px;
        }

        .round-history-search-note {
            color: var(--accent-color);
            font-size: 0.85rem;
            margin-top: 8px;
        }

        .round-history-empty {
            color: var(--text-muted);
            border: 1px dashed var(--border-color);
            padding: 16px;
            text-align: center;
        }

        /* Tables */
        .table-container {
            overflow-x: auto;
        }

        .list-toolbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin: -6px 0 10px 0;
            color: var(--text-muted);
            font-size: 0.85rem;
        }

        .list-summary-note {
            min-height: 1em;
        }

        .view-toggle {
            display: inline-flex;
            border: 1px solid var(--border-color);
            background: #000;
        }

        .toggle-btn {
            background: transparent;
            border: none;
            color: var(--text-muted);
            font-family: inherit;
            padding: 6px 10px;
            cursor: pointer;
        }

        .toggle-btn.active {
            background: var(--accent-color);
            color: #000;
            font-weight: bold;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
        }

        th {
            color: var(--text-muted);
            font-weight: normal;
            padding: 10px 5px;
            border-bottom: 1px solid var(--border-color);
        }

        td {
            padding: 10px 5px;
            border-bottom: 1px solid #222;
        }

        tr:hover td {
            background-color: #1a1a1a;
        }

        .static-row td {
            color: var(--accent-color);
            font-style: italic;
        }

        /* Search Highlight Row Style */
        tr.highlight-row td {
            background-color: rgba(189, 89, 255, 0.2);
            color: var(--highlight-color);
            font-weight: bold;
            border-bottom: 1px solid var(--highlight-color);
        }

        .omitted-row td {
            color: var(--text-muted);
            text-align: center;
            font-style: italic;
        }

        /* Footer */
        footer {
            margin-top: 50px;
            text-align: center;
            font-size: 0.9rem;
            color: var(--text-muted);
        }

        footer a {
            margin: 0 10px;
        }

        /* Modals */
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.8);
            z-index: 2000;
            justify-content: center;
            align-items: center;
        }

        .modal-content {
            background: var(--bg-color);
            border: 2px solid var(--accent-color);
            padding: 30px;
            max-width: 600px;
            width: 90%;
            max-height: 80vh;
            overflow-y: auto;
            position: relative;
        }

        .close-modal {
            position: absolute;
            top: 10px;
            right: 15px;
            font-size: 1.5rem;
            color: var(--accent-color);
            cursor: pointer;
        }

        /* --- RESPONSIVE --- */
        @@media (max-width: 1100px) {
            .logo-img {
                position: relative;
                display: block;
                margin: 0 auto 20px auto;
                top: 0;
                left: 0;
            }

            .charts-section {
                grid-template-columns: 1fr;
            }

            .round-detail-columns {
                grid-template-columns: 1fr;
            }

            .round-history-toolbar {
                align-items: flex-start;
            }

            .list-toolbar {
                flex-direction: column;
                align-items: flex-start;
            }
        }
    </style>
</head>
<body>

<div class="dev-banner">
    ⚠️ DEVELOPER PREVIEW: EXPECT FREQUENT SERVER REBOOTS AND COPIUS BUGS ⚠️
</div>

<img src="logo.png" alt="Grid Labs" class="logo-img"/>

<div class="main-container">
    <h1>BOOT PROTOCOL</h1>

    <div class="search-section">
        <div class="search-box-container">
            <input type="text" id="search-input" class="search-input" placeholder="Enter Wallet Address..."
                   onkeypress="if(event.key === 'Enter') performSearch()">
            <button class="search-btn" onclick="performSearch()">SEARCH</button>
        </div>
        <div id="search-results" class="search-results"></div>
    </div>

    <div class="info-grid">
        <div class="info-box">
            <h3>🏆 All-Time Best Diff</h3>
            <div class="info-value accent-value" id="record-diff">0</div>
            <h3>Miner</h3>
            <div class="info-value" id="record-miner">None</div>
            <h3>Time (UTC)</h3>
            <div class="info-value" id="record-time">--</div>
        </div>

        <div class="info-box">
            <h3>📡 Connection Info</h3>
            <div>Host: <span class="accent-value" id="server-host">Loading...</span></div>
            <div>Port: <span class="accent-value" id="server-port">Loading...</span></div>
            <h3 style="margin-top: 10px;">Pool Pubkey</h3>
            <div class="key-container">
                <span id="server-pubkey-display">Loading...</span>
                <button onclick="copyPubKey()" class="copy-btn" title="Copy Key">📋</button>
            </div>
            <div id="copy-feedback" style="color: var(--accent-color); height: 15px; font-size: 0.7em;"></div>
        </div>

        <div class="info-box">
            <h3>🕸 Network State</h3>
            <div>Self: <span class="accent-value" id="self-endpoint">--</span></div>
            <div>Network: <span class="accent-value" id="network-id">Loading...</span></div>
            <div>Template Slots: <span class="accent-value" id="template-slot-count">Loading...</span></div>
            <div>Peers: <span class="accent-value" id="peer-count">0</span></div>
            <div>Current State: <span class="accent-value" id="current-state-id">Loading...</span></div>
            <div>Candidate State: <span class="accent-value" id="candidate-state-id">Loading...</span></div>
            <div>Test Trigger: <span class="accent-value" id="testing-trigger-status">Loading...</span></div>
            <div>Last Test Block: <span class="accent-value" id="last-testing-trigger-block">--</span></div>
            <h3 style="margin-top: 10px;">Commitment Preview</h3>
            <div class="info-value" id="commitment-preview">Loading...</div>
            <div class="search-results" id="commitment-note"></div>
            <div class="search-results" id="testing-trigger-note"></div>
        </div>
    </div>

    <h2>Difficulty Distribution</h2>
    <div class="charts-section">
        <div class="chart-container">
            <canvas id="winnersChart"></canvas>
        </div>
        <div class="chart-container">
            <canvas id="onDeckChart"></canvas>
        </div>
    </div>

    <section>
        <h2>Peer Status</h2>
        <div class="table-container">
            <table id="peer-list">
                <thead>
                <tr>
                    <th>Endpoint</th>
                    <th>Status</th>
                    <th>Latency</th>
                    <th>Last Seen</th>
                </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </section>

    <section style="margin-top: 30px;">
        <h2>Round History</h2>
        <div class="round-history-toolbar">
            <div class="round-history-note" id="round-history-note">Loading round history...</div>
            <div class="view-toggle">
                <button class="toggle-btn active" id="rounds-oldest-left-btn" onclick="setRoundHistoryOrder('oldest-left')">OLD LEFT</button>
                <button class="toggle-btn" id="rounds-newest-left-btn" onclick="setRoundHistoryOrder('newest-left')">NEW LEFT</button>
            </div>
        </div>
        <div class="round-history-scroller" id="round-history-scroller"></div>
        <div class="round-detail" id="round-history-detail">
            <div class="round-history-empty">No completed rounds recorded yet.</div>
        </div>
        <div class="chart-container round-history-chart" style="margin-top: 16px;">
            <canvas id="roundShareChart"></canvas>
            <div class="round-history-search-note" id="round-history-search-note"></div>
        </div>
    </section>

    <div class="lists-container">
        <section>
            <h2>
                Current Winners List
                <span class="info-icon"
                      data-tooltip="High difficulty shares that won the last round.  Miners put these payouts in their coinbase transaction (including one spot for their own) to compete in the current round.">i</span>
            </h2>
            <div class="list-toolbar">
                <div class="list-summary-note" id="winners-summary-note"></div>
                <div class="view-toggle">
                    <button class="toggle-btn active" id="winners-summary-btn" onclick="setListViewMode('winners-list', 'summary')">SUMMARY</button>
                    <button class="toggle-btn" id="winners-full-btn" onclick="setListViewMode('winners-list', 'full')">FULL</button>
                </div>
            </div>
            <div class="table-container">
                <table id="winners-list">
                    <thead>
                    <tr>
                        <th>Address</th>
                        <th>Value (BTC)</th>
                        <th>Difficulty</th>
                    </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </section>

        <section style="margin-top: 30px;">
            <h2>
                On-Deck List
                <span class="info-icon"
                      data-tooltip="The current round of competition. When the team finds a new block, these addresses get locked into the Winners List.">i</span>
            </h2>
            <div class="list-toolbar">
                <div class="list-summary-note" id="ondeck-summary-note"></div>
                <div class="view-toggle">
                    <button class="toggle-btn active" id="ondeck-summary-btn" onclick="setListViewMode('ondeck-list', 'summary')">SUMMARY</button>
                    <button class="toggle-btn" id="ondeck-full-btn" onclick="setListViewMode('ondeck-list', 'full')">FULL</button>
                </div>
            </div>
            <div class="table-container">
                <table id="ondeck-list">
                    <thead>
                    <tr>
                        <th>Address</th>
                        <th>Value (BTC)</th>
                        <th>Difficulty</th>
                    </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </section>
    </div>

        <footer>
            <a href="https://github.com/gridlabs-science/boot-protocol" target="_blank">SOURCE CODE</a> |
            <a onclick="toggleModal('theory-modal')">THEORY</a> |
            <a onclick="toggleModal('help-modal')">HELP</a> |
            <a onclick="toggleModal('test-modal')">TEST TOOLS</a>
        </footer>
    </div> 

<div id="theory-modal" class="modal-overlay" onclick="if(event.target === this) toggleModal('theory-modal')">
    <div class="modal-content">
        <span class="close-modal" onclick="toggleModal('theory-modal')">&times;</span>
        <h2>Pool Theory</h2>
        <p>Boot Protocol operates differently than traditional pools. It's more like a protocol for solo miners to split
            rewards in exchange for better odds.</p>
        <p>Nodes maintain a "Winners List", which defines the 299 shared payout slots for the coinbase split. Slot 0 always belongs to the block finder, so a full template has 300 total payout slots.
            Miners make their own templates using this coinbase payout, and submit the highest difficulty shares to the
            nodes.
            Nodes keep track of top shares with the "On Deck List". Once someone finds a golden nonce and the Winner's
            List is paid on the Bitcoin blockchain,
            the "On Deck List" becomes the new Winner's List. </p>
        <p>This model has some interesting attributes. It should have scalable resistance to block withholding attacks,
            since a block withholding miner would usually hurt
            themselves more than the other miners. It is trivial to run decentralized, and bandwidth requirements
            between nodes are very small. It can be used by small
            lottery miners to increase their odds of a (smaller) jackpot, and by large pools to lower their variance in
            coordination with other pools while controlling their own templates.
            It doesn't have the centralization pressure caused by fast block times. </p>
        <p>We hope it will be a useful option for Bitcoin miners who value decentralization.</p>
    </div>
</div>

<div id="help-modal" class="modal-overlay" onclick="if(event.target === this) toggleModal('help-modal')">
    <div class="modal-content">
        <span class="close-modal" onclick="toggleModal('help-modal')">&times;</span>
        <h2>How to Connect</h2>
        <p>There are two options to join the Boot team and compete to get on the Winner's List:</p>
        <h3>The easy way (start with this):</h3>
        <p>1. Download the DATUM client.</p>
        <p>2. Configure your client with the host, port, and public key listed above.</p>
        <p>3. Start mining. Your highest difficulty shares will automatically be submitted.</p>
        <h3>The better way (after the above steps):</h3>
        <p>4. Go to the Boot Protocol repository and choose an installation method (bare metal or Docker)</p>
        <p>5. Start up the Boot Server, visit http://localhost:5000 and copy the public key</p>
        <p>6. Edit your DATUM Config to point towards your new Datum Server</p>
        <p>7. Get your friends to do the same!</p>
    </div>
</div>

<div id="test-modal" class="modal-overlay" onclick="if(event.target === this) toggleModal('test-modal')">
    <div class="modal-content">
        <span class="close-modal" onclick="toggleModal('test-modal')">&times;</span>
        <h2>Test Tools</h2>
        <p>Use this only for local node testing. This button does not propagate to peers.</p>
        <p>The preferred distributed test path is the automatic Bitcoin block-hash trigger shown in the Network State panel.</p>
        <div class="search-box-container" style="margin-top: 20px;">
            <input type="password" id="admin-api-key" class="search-input" placeholder="Admin API Key">
            <button class="search-btn" onclick="triggerManualReset()">LOCAL RESET</button>
        </div>
        <div id="admin-reset-status" class="search-results" style="margin-top: 12px;"></div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
<script>
    let fullServerPubKey = "";
    let winnersChartInstance = null;
    let onDeckChartInstance = null;
    let roundShareChartInstance = null;
    let latestNetworkState = null;
    let globalRoundHistory = [];
    let selectedRoundStateId = null;
    let roundHistoryOrder = localStorage.getItem("boot-round-history-order") || "oldest-left";

    // Global state for client-side searching
    let globalWinnersList = [];
    let globalOnDeckList = [];
    let currentSearchTerm = "";
    const listViewModes = {
        "winners-list": "summary",
        "ondeck-list": "summary"
    };

    // --- INITIALIZE URL SEARCH ---
    // Checks if the URL is like /bc1q... and pre-fills the search
    window.addEventListener('DOMContentLoaded', () => {
        const path = window.location.pathname.substring(1); // Remove leading '/'
        // Simple check to ignore SignalR paths or empty paths
        if (path && path.length > 15 && !path.includes("/")) {
            const input = document.getElementById('search-input');
            input.value = path;
            currentSearchTerm = path; // Set immediate state
        }
    });

    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/poolStatsHub")
        .withAutomaticReconnect()
        .build();

    // --- SEARCH LOGIC ---
    function performSearch() {
        const input = document.getElementById('search-input');
        const rawTerm = input.value.trim();
        currentSearchTerm = rawTerm;
        const resultDiv = document.getElementById('search-results');

        if (!rawTerm) {
            resultDiv.innerHTML = "";
            refreshUI(); // Clear highlights
            return;
        }

        // 1. Scan Winners
        const winnerMatches = globalWinnersList
            .map((item, index) => ({item, index: index + 1})) // 1-based index
            .filter(x => x.item.username.toLowerCase().includes(rawTerm.toLowerCase()));

        const winnerTotal = winnerMatches.reduce((sum, x) => sum + x.item.value, 0);

        // 2. Scan OnDeck
        const deckMatches = globalOnDeckList
            .map((item, index) => ({item, index: index + 1}))
            .filter(x => x.item.username.toLowerCase().includes(rawTerm.toLowerCase()));

        const deckTotal = deckMatches.reduce((sum, x) => sum + x.item.value, 0);

        // 3. Build Output
        if (winnerMatches.length === 0 && deckMatches.length === 0) {
            resultDiv.innerHTML = `This address does not have any shares on the lists yet. Keep hashing!`;
        } else {
            let msg = "";
            if (deckMatches.length > 0) {
                const deckIndices = deckMatches.map(x => '#' + x.index).join(', ');
                const deckBtc = (deckTotal / 100000000.0).toFixed(8);
                msg += `<div><span class="result-highlight">On Deck List:</span> ${deckIndices}. Potential payout: ${deckBtc} BTC</div>`;
            }
            if (winnerMatches.length > 0) {
                const winIndices = winnerMatches.map(x => '#' + x.index).join(', ');
                const winBtc = (winnerTotal / 100000000.0).toFixed(8);
                msg += `<div><span class="result-highlight">Winners List:</span> ${winIndices}. Locked payout: ${winBtc} BTC</div>`;
            }
            resultDiv.innerHTML = msg;
        }

        // 4. Trigger UI Redraw to show highlights
        refreshUI();
    }

    function refreshUI() {
        updateTable("winners-list", globalWinnersList);
        updateTable("ondeck-list", globalOnDeckList);
        renderRoundHistory(globalRoundHistory);

        // Re-draw charts with the vertical lines
        winnersChartInstance = updateChart("winnersChart", globalWinnersList, "Winners List Depth", winnersChartInstance);
        onDeckChartInstance = updateChart("onDeckChart", globalOnDeckList, "On-Deck List Depth", onDeckChartInstance);
    }


    // --- STANDARD HELPERS ---
    function formatAddress(address) {
        if (!address) return "Unknown";
        const dotIndex = address.indexOf('.');
        let mainPart = address;
        let suffix = "";
        if (dotIndex !== -1) {
            mainPart = address.substring(0, dotIndex);
            suffix = address.substring(dotIndex);
        }
        if (mainPart.length <= 12) return address;
        const first6 = mainPart.substring(0, 6);
        const last6 = mainPart.substring(mainPart.length - 6);
        return `${first6}...${last6}${suffix}`;
    }

    function formatBtcFromSats(value) {
        return ((value || 0) / 100000000.0).toFixed(8);
    }

    function formatPercent(part, total) {
        if (!total) return "0.0%";
        return `${((part / total) * 100).toFixed(1)}%`;
    }

    function normalizeSearchValue(value) {
        return (value || "").toLowerCase();
    }

    function currentSearchValue() {
        return normalizeSearchValue(currentSearchTerm);
    }

    function formatTimestamp(value) {
        if (!value) return "--";
        return new Date(value).toLocaleString();
    }

    function formatBlockLabel(hash, height) {
        if (height != null) return `Block ${height.toLocaleString()}`;
        return `Block ${shortenHash(hash)}`;
    }

    function getBlockExplorerUrl(hash) {
        if (!hash) return null;
        return `https://mempool.space/block/${hash}`;
    }

    function describeRoundKind(kind) {
        if (!kind) return "round";
        if (kind.startsWith("test-trigger:")) return "test";
        if (kind === "manual-rotation") return "manual";
        if (kind === "manual-reset") return "manual";
        if (kind.startsWith("adopted-state:")) return "adopted";
        if (kind.startsWith("bootstrap-state:")) return "bootstrap";
        return kind.replace(/[:_]/g, " ");
    }

    function roundHistoryDisplayOrder(history) {
        if (roundHistoryOrder === "newest-left") {
            return [...history];
        }

        return [...history].reverse();
    }

    function setRoundHistoryOrder(order) {
        roundHistoryOrder = order === "newest-left" ? "newest-left" : "oldest-left";
        localStorage.setItem("boot-round-history-order", roundHistoryOrder);
        document.getElementById("rounds-oldest-left-btn").classList.toggle("active", roundHistoryOrder === "oldest-left");
        document.getElementById("rounds-newest-left-btn").classList.toggle("active", roundHistoryOrder === "newest-left");
        renderRoundHistory(globalRoundHistory);
    }

    function recipientMatchesSearch(item) {
        const term = currentSearchValue();
        if (!term) return false;
        const address = normalizeSearchValue(item.address);
        const username = normalizeSearchValue(item.username);
        return address.includes(term) || username.includes(term);
    }

    function computeRecipientShare(recipients, totalValue) {
        if (!currentSearchValue()) return null;
        const matchingValue = (recipients || [])
            .filter(recipientMatchesSearch)
            .reduce((sum, item) => sum + (item.totalValue || 0), 0);
        return {
            value: matchingValue,
            percent: totalValue ? (matchingValue / totalValue) * 100 : 0
        };
    }

    function buildRoundPreview(recipients, totalValue) {
        if (!recipients || recipients.length === 0) return "No payouts";
        return recipients.slice(0, 3).map(entry => {
            const label = formatAddress(entry.username || entry.address);
            return `${label} ${formatPercent(entry.totalValue, totalValue)}`;
        }).join(" · ");
    }

    function renderRoundHistory(history) {
        const note = document.getElementById("round-history-note");
        const scroller = document.getElementById("round-history-scroller");
        const detail = document.getElementById("round-history-detail");
        scroller.innerHTML = "";
        document.getElementById("rounds-oldest-left-btn").classList.toggle("active", roundHistoryOrder === "oldest-left");
        document.getElementById("rounds-newest-left-btn").classList.toggle("active", roundHistoryOrder === "newest-left");

        if (!history || history.length === 0) {
            note.innerText = "No completed rounds recorded yet.";
            detail.innerHTML = '<div class="round-history-empty">Completed rounds will appear here after the next lock.</div>';
            updateRoundShareChart([]);
            selectedRoundStateId = null;
            return;
        }

        note.innerText = `Showing the most recent ${history.length} completed rounds. Order is ${roundHistoryOrder === "oldest-left" ? "oldest to newest" : "newest to oldest"}.`;

        if (!selectedRoundStateId || !history.some(entry => entry.stateId === selectedRoundStateId)) {
            selectedRoundStateId = history[0].stateId;
        }

        const displayHistory = roundHistoryDisplayOrder(history);
        displayHistory.forEach((entry) => {
            const card = document.createElement("button");
            card.type = "button";
            card.className = `round-card${entry.stateId === selectedRoundStateId ? " active" : ""}`;
            card.onclick = () => {
                selectedRoundStateId = entry.stateId;
                renderRoundHistory(globalRoundHistory);
            };

            const explorerUrl = getBlockExplorerUrl(entry.triggerBlockHash);
            card.innerHTML = `
                <div class="round-card-header">
                    <div class="round-card-title">Round ${entry.roundNumber}</div>
                    <div class="round-kind-pill">${describeRoundKind(entry.kind)}</div>
                </div>
                <div class="round-card-meta">${formatBlockLabel(entry.triggerBlockHash, entry.triggerBlockHeight)}</div>
                <div class="round-card-meta">${formatTimestamp(entry.lockedAtUtc)}</div>
                ${explorerUrl ? `<div class="round-card-meta"><a class="round-card-link" href="${explorerUrl}" target="_blank" rel="noopener noreferrer" onclick="event.stopPropagation()">Open Block</a></div>` : ""}
                <div class="round-card-preview"><strong>Paid:</strong> ${buildRoundPreview(entry.paidRecipients, entry.paidTotalValue)}</div>
                <div class="round-card-preview"><strong>Next:</strong> ${buildRoundPreview(entry.nextRecipients, entry.nextWinnerTotalValue)}</div>
            `;
            scroller.appendChild(card);
        });

        const selected = history.find(entry => entry.stateId === selectedRoundStateId) || history[0];
        renderRoundHistoryDetail(selected, detail);
        updateRoundShareChart(history);
    }

    function renderRoundHistoryDetail(entry, container) {
