                </div>` : ""}
                ${nextSearchShare ? `
                <div class="round-detail-box">
                    <h3>Search Match Next Share</h3>
                    <div class="round-detail-value">${nextSearchShare.percent.toFixed(1)}% (${formatBtcFromSats(nextSearchShare.value)} BTC)</div>
                </div>` : ""}
            </div>
            <div class="round-detail-columns">
                <div>
                    <h3>Paid Recipients</h3>
