@page
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>BOOT PROTOCOL</title>
    <link href="https://fonts.googleapis.com/css2?family=Roboto+Mono:wght@400;500;700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        :root {
            --bg-color: #111111;
            --text-color: #eeeeee;
            --text-muted: #888888;
            /* UPDATED: Neon Purple to match Grid Labs Logo */
            --accent-color: #bd59ff; 
            --border-color: #333333;
            --container-width: 900px;
        }

        body {
            font-family: 'Roboto Mono', monospace;
            background-color: var(--bg-color);
            color: var(--text-color);
            margin: 0;
            padding: 20px;
            line-height: 1.4;
        }

        /* --- LOGO STYLING --- */
        .logo-img {
            position: absolute;
            top: 20px;
            left: 30px;
            width: 160px; /* Adjust size as desired */
            height: auto;
            opacity: 0.9;
            transition: opacity 0.3s;
        }
        .logo-img:hover { opacity: 1; }

        /* Main Layout */
        .main-container {
            max-width: var(--container-width);
            margin: 0 auto;
            padding-top: 20px; /* Space for when logo is absolute */
        }

        /* Typography */
        h1, h2, h3 {
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 1rem;
            font-weight: 700;
        }
        h1 { color: var(--accent-color); text-align: center; margin-top: 0; }
        h2 { font-size: 1.2rem; border-bottom: 1px solid var(--border-color); padding-bottom: 5px; margin-top: 30px;}

        a { color: var(--accent-color); text-decoration: none; cursor: pointer;}
        a:hover { text-decoration: underline; }

        /* Search Section */
        .search-section { margin-bottom: 40px; text-align: center; }
        .search-box-container {
            display: inline-flex;
            border: 1px solid var(--border-color);
            padding: 5px;
            background: #000;
        }
        .search-input {
            background: transparent; border: none; color: var(--text-color);
            font-family: inherit; padding: 8px; width: 300px; outline: none;
        }
        .search-btn {
            background: var(--accent-color); border: none; color: #000;
            font-family: inherit; padding: 8px 15px; font-weight: bold; cursor: pointer;
        }
        .search-btn:hover { opacity: 0.9; }

        /* Info Grids */
        .info-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }
        .info-box {
            border: 1px solid var(--border-color);
            padding: 15px;
        }
        .info-box h3 { font-size: 0.9rem; color: var(--text-muted); margin: 0 0 10px 0; }
        .info-value { font-size: 1.1rem; word-break: break-all;}
        .accent-value { color: var(--accent-color); }

        .key-container { 
            display: flex; align-items: center; justify-content: space-between; 
            background: #000; padding: 5px; font-size: 0.85rem; border: 1px solid var(--border-color);
        }
        .copy-btn { background: transparent; border: none; color: var(--text-muted); cursor: pointer; }
        .copy-btn:hover { color: var(--accent-color); }

        /* Charts */
        .charts-section {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 30px;
        }
        .chart-container { border: 1px solid var(--border-color); padding: 15px; height: 250px;}
        
        /* Tables */
        .table-container { overflow-x: auto; }
        table { width: 100%; border-collapse: collapse; text-align: left; }
        th { color: var(--text-muted); font-weight: normal; padding: 10px 5px; border-bottom: 1px solid var(--border-color); }
        td { padding: 10px 5px; border-bottom: 1px solid #222; }
        tr:hover td { background-color: #1a1a1a; }
        .static-row td { color: var(--accent-color); font-style: italic;}

        /* Footer */
        footer { margin-top: 50px; text-align: center; font-size: 0.9rem; color: var(--text-muted); }
        footer a { margin: 0 10px; }

        /* Modals */
        .modal-overlay {
            display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.8); z-index: 100; justify-content: center; align-items: center;
        }
        .modal-content {
            background: var(--bg-color); border: 2px solid var(--accent-color);
            padding: 30px; max-width: 600px; width: 90%; max-height: 80vh; overflow-y: auto; position: relative;
        }
        .close-modal { position: absolute; top: 10px; right: 15px; font-size: 1.5rem; color: var(--accent-color); cursor: pointer; }

        /* --- RESPONSIVE --- */
        /* Use double 'at' to escape Razor syntax */
        @@media (max-width: 1100px) {
            /* On smaller screens, stop absolute positioning the logo and center it */
            .logo-img {
                position: relative;
                display: block;
                margin: 0 auto 20px auto;
                top: 0; left: 0;
            }
            .main-container { padding-top: 0; }
            .charts-section { grid-template-columns: 1fr; } 
        }
    </style>
</head>
<body>

    <img src="logo.png" alt="Grid Labs" class="logo-img" />

    <div class="main-container">
        <h1>BOOT PROTOCOL</h1>

        <div class="search-section">
            <div class="search-box-container">
                <input type="text" class="search-input" placeholder="Enter Wallet Address...">
                <button class="search-btn">SEARCH</button>
            </div>
        </div>

        <div class="info-grid">
            <div class="info-box">
                 <h3>🏆 All-Time Best Diff</h3>
                 <div class="info-value accent-value" id="record-diff">0</div>
                 <h3>Miner</h3>
                 <div class="info-value" id="record-miner">None</div>
                 <h3>Time (UTC)</h3>
                 <div class="info-value" id="record-time">--</div>
            </div>

             <div class="info-box">
                 <h3>📡 Connection Info</h3>
                 <div>Host: <span class="accent-value">datum.gridlabs.science</span></div>
                 <div>Port: <span class="accent-value" id="server-port">Loading...</span></div>
                 <h3 style="margin-top: 10px;">Pool Pubkey</h3>
                 <div class="key-container">
                    <span id="server-pubkey-display">Loading...</span>
                    <button onclick="copyPubKey()" class="copy-btn" title="Copy Key">📋</button>
                </div>
                <div id="copy-feedback" style="color: var(--accent-color); height: 15px; font-size: 0.7em;"></div>
            </div>
        </div>

        <h2>Difficulty Distribution</h2>
        <div class="charts-section">
            <div class="chart-container">
                <canvas id="winnersChart"></canvas>
            </div>
            <div class="chart-container">
                <canvas id="onDeckChart"></canvas>
            </div>
        </div>

        <div class="lists-container">
            <section>
                <h2>Current Winners List</h2>
                <div class="table-container">
                    <table id="winners-list">
                        <thead><tr><th>Address</th><th>Value (BTC)</th><th>Difficulty</th></tr></thead>
                        <tbody></tbody>
                    </table>
                </div>
            </section>

            <section style="margin-top: 30px;">
                <h2>On-Deck List</h2>
                <div class="table-container">
                     <table id="ondeck-list">
                        <thead><tr><th>Address</th><th>Value (BTC)</th><th>Difficulty</th></tr></thead>
                        <tbody></tbody>
                    </table>
                </div>
            </section>
        </div>

        <footer>
            <a href="https://github.com/gridlabs-science/boot-protocol" target="_blank">GITHUB</a> |
            <a onclick="toggleModal('theory-modal')">THEORY</a> |
            <a onclick="toggleModal('help-modal')">HELP</a>
        </footer>

    </div> 


    <div id="theory-modal" class="modal-overlay" onclick="if(event.target === this) toggleModal('theory-modal')">
        <div class="modal-content">
            <span class="close-modal" onclick="toggleModal('theory-modal')">&times;</span>
            <h2>Pool Theory</h2>
            <p>Boot Protocol operates differently than traditional pools.</p>
            <p>We maintain a competitive "Winners List". Only the highest difficulty shares submitted make it onto the list.</p>
            <p>When a block is found, the reward is split among those currently on the list based on their position.</p>
        </div>
    </div>

    <div id="help-modal" class="modal-overlay" onclick="if(event.target === this) toggleModal('help-modal')">
        <div class="modal-content">
            <span class="close-modal" onclick="toggleModal('help-modal')">&times;</span>
            <h2>How to Connect</h2>
            <p>1. Download the DATUM client.</p>
            <p>2. Configure your client with the host, port, and public key listed above.</p>
            <p>3. Start mining. Your highest difficulty shares will automatically be submitted.</p>
        </div>
    </div>


    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script>
        let fullServerPubKey = "";
        let winnersChartInstance = null;
        let onDeckChartInstance = null;

        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/poolStatsHub")
            .withAutomaticReconnect()
            .build();

        // Helper Functions
        function formatAddress(address) {
            if (!address) return "Unknown";
            const dotIndex = address.indexOf('.');
            let mainPart = address;
            let suffix = "";
            if (dotIndex !== -1) {
                mainPart = address.substring(0, dotIndex);
                suffix = address.substring(dotIndex);
            }
            if (mainPart.length <= 12) return address;
            const first6 = mainPart.substring(0, 6);
            const last6 = mainPart.substring(mainPart.length - 6);
            return `${first6}...${last6}${suffix}`;
        }

        function copyPubKey() {
            if (!fullServerPubKey) return;
            navigator.clipboard.writeText(fullServerPubKey).then(() => {
                const feedback = document.getElementById("copy-feedback");
                feedback.innerText = "COPIED!";
                setTimeout(() => feedback.innerText = "", 2000);
            });
        }

        function toggleModal(modalId) {
            const modal = document.getElementById(modalId);
            modal.style.display = modal.style.display === 'flex' ? 'none' : 'flex';
        }

        function updateTable(tableId, list) {
            const tableBody = document.querySelector(`#${tableId} tbody`);
            tableBody.innerHTML = '';

            if (tableId === "winners-list") {
                tableBody.innerHTML += `
                    <tr class="static-row">
                        <td>[YourAddressHere]</td><td>1 share + fees</td><td>>NetworkDiff</td>
                    </tr>`;
            }

            if (!list) return;

            list.forEach(payout => {
                const btcValue = payout.value / 100000000.0;
                const formattedAddr = formatAddress(payout.address);
                const diffVal = payout.difficulty || 0;
                const diffDisplay = payout.diffString || diffVal.toLocaleString(undefined, {maximumFractionDigits: 2});

                const row = `<tr>
                    <td title="${payout.address}">${formattedAddr}</td>
                    <td>${btcValue.toFixed(8)}</td>
                    <td>${diffDisplay}</td>
                </tr>`;
                tableBody.innerHTML += row;
            });
        }

        function updateChart(canvasId, list, chartTitle, chartInstanceRef) {
            const ctx = document.getElementById(canvasId).getContext('2d');
            const plotData = list.map(x => x.difficulty).reverse(); 
            const labels = list.map((_, index) => list.length - index); 

            if (chartInstanceRef) chartInstanceRef.destroy();

            // Read the new purple accent color from CSS
            const accentColor = getComputedStyle(document.documentElement).getPropertyValue('--accent-color').trim();

            const newChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Difficulty',
                        data: plotData,
                        borderColor: accentColor,
                        backgroundColor: accentColor + '33', 
                        borderWidth: 2,
                        pointRadius: 2,
                        fill: true,
                        tension: 0.2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        title: { display: true, text: chartTitle, color: '#888' },
                        tooltip: {
                             mode: 'index', intersect: false,
                             callbacks: { label: function(context) { return `Diff: ${context.raw.toLocaleString()}`; } }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: { color: '#333', drawBorder: false },
                            ticks: { color: '#888', callback: function(value) {
                                if(value > 1000000) return (value/1000000).toFixed(1) + 'M';
                                if(value > 1000) return (value/1000).toFixed(0) + 'K';
                                return value;
                            }}
                        },
                        x: { grid: { display: false }, ticks: { display: false } }
                    }
                }
            });
            return newChart;
        }

        // SignalR Handlers
        connection.on("UpdateWinners", (list) => {
            updateTable("winners-list", list);
            winnersChartInstance = updateChart("winnersChart", list, "Winners List Depth", winnersChartInstance);
        });

        connection.on("UpdateOnDeck", (list) => {
            updateTable("ondeck-list", list);
            onDeckChartInstance = updateChart("onDeckChart", list, "On-Deck List Depth", onDeckChartInstance);
        });

        connection.on("UpdateRecord", (record) => {
            if (record) {
                document.getElementById("record-diff").innerText = record.difficulty.toLocaleString(undefined, {maximumFractionDigits: 2});
                document.getElementById("record-miner").innerText = formatAddress(record.minerAddress);
                document.getElementById("record-time").innerText = record.timestamp ? new Date(record.timestamp).toLocaleString() : "--";
            }
        });

        connection.on("UpdateServerInfo", (info) => {
            fullServerPubKey = info.pubKey;
            document.getElementById("server-port").innerText = info.poolPort;
            if(info.pubKey && info.pubKey.length > 16) {
                const first = info.pubKey.substring(0, 8);
                const last = info.pubKey.substring(info.pubKey.length - 8);
                document.getElementById("server-pubkey-display").innerText = `${first}...${last}`;
            } else {
                document.getElementById("server-pubkey-display").innerText = info.pubKey;
            }
        });

        async function start() {
            try {
                await connection.start();
                await connection.invoke("GetInitialData");
            } catch (err) {
                console.error(err);
                setTimeout(start, 5000);
            }
        };

        start();
    </script>
</body>
</html>