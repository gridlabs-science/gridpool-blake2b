@page "{addr?}"
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>BOOT PROTOCOL</title>
    <link href="https://fonts.googleapis.com/css2?family=Roboto+Mono:wght@400;500;700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        :root {
            --bg-color: #111111;
            --text-color: #eeeeee;
            --text-muted: #888888;
            --accent-color: #bd59ff;
            --highlight-color: #ffffff; /* Bright white for search matches */
            --border-color: #333333;
            --container-width: 900px;
        }

        body {
            font-family: 'Roboto Mono', monospace;
            background-color: var(--bg-color);
            color: var(--text-color);
            margin: 0;
            padding: 0; /* Removed padding for banner */
            line-height: 1.4;
        }

        /* --- DEV BANNER --- */
        .dev-banner {
            background: repeating-linear-gradient(
                45deg,
                #d4af37,
                #d4af37 10px,
                #bfa030 10px,
                #bfa030 20px
            );
            color: #000;
            text-align: center;
            font-weight: bold;
            padding: 5px;
            font-size: 0.8rem;
            border-bottom: 2px solid #000;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        /* --- LOGO STYLING --- */
        .logo-img {
            position: absolute;
            top: 45px; /* Adjusted for banner */
            left: 30px;
            width: 160px;
            height: auto;
            opacity: 0.9;
            transition: opacity 0.3s;
        }

        .logo-img:hover {
            opacity: 1;
        }

        /* Main Layout */
        .main-container {
            max-width: var(--container-width);
            margin: 0 auto;
            padding: 40px 20px 20px 20px;
        }

        /* Typography */
        h1, h2, h3 {
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 1rem;
            font-weight: 700;
        }

        h1 {
            color: var(--accent-color);
            text-align: center;
            margin-top: 0;
        }

        h2 {
            font-size: 1.2rem;
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 5px;
            margin-top: 30px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        a {
            color: var(--accent-color);
            text-decoration: none;
            cursor: pointer;
        }

        a:hover {
            text-decoration: underline;
        }

        /* --- TOOLTIPS (INFO ICONS) --- */
        .info-icon {
            display: inline-block;
            width: 18px;
            height: 18px;
            border: 1px solid var(--text-muted);
            border-radius: 50%;
            text-align: center;
            line-height: 16px;
            font-size: 12px;
            color: var(--text-muted);
            cursor: help;
            position: relative;
        }

        .info-icon:hover::after {
            content: attr(data-tooltip);
            position: absolute;
            bottom: 125%;
            left: 50%;
            transform: translateX(-50%);
            background: #333;
            color: #fff;
            padding: 8px;
            border-radius: 4px;
            font-size: 12px;
            width: 200px;
            text-transform: none;
            font-weight: normal;
            z-index: 10;
            border: 1px solid var(--accent-color);
        }

        /* Search Section */
        .search-section {
            margin-bottom: 40px;
            text-align: center;
        }

        .search-box-container {
            display: inline-flex;
            border: 1px solid var(--border-color);
            padding: 5px;
            background: #000;
        }

        .search-input {
            background: transparent;
            border: none;
            color: var(--text-color);
            font-family: inherit;
            padding: 8px;
            width: 300px;
            outline: none;
        }

        .search-btn {
            background: var(--accent-color);
            border: none;
            color: #000;
            font-family: inherit;
            padding: 8px 15px;
            font-weight: bold;
            cursor: pointer;
        }

        .search-btn:hover {
            opacity: 0.9;
        }

        /* Search Results Text */
        .search-results {
            margin-top: 15px;
            min-height: 20px;
            font-size: 0.9rem;
            color: var(--text-muted);
        }

        .result-highlight {
            color: var(--highlight-color);
            font-weight: bold;
        }

        /* Info Grids */
        .info-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .info-box {
            border: 1px solid var(--border-color);
            padding: 15px;
        }

        .info-box h3 {
            font-size: 0.9rem;
            color: var(--text-muted);
            margin: 0 0 10px 0;
        }

        .info-value {
            font-size: 1.1rem;
            word-break: break-all;
        }

        .accent-value {
            color: var(--accent-color);
        }

        .key-container {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: #000;
            padding: 5px;
            font-size: 0.85rem;
            border: 1px solid var(--border-color);
        }

        .copy-btn {
            background: transparent;
            border: none;
            color: var(--text-muted);
            cursor: pointer;
        }

        .copy-btn:hover {
            color: var(--accent-color);
        }

        /* Charts */
        .charts-section {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 30px;
        }

        .chart-container {
            border: 1px solid var(--border-color);
            padding: 15px;
            height: 250px;
        }

        /* Tables */
        .table-container {
            overflow-x: auto;
        }

        .list-toolbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin: -6px 0 10px 0;
            color: var(--text-muted);
            font-size: 0.85rem;
        }

        .list-summary-note {
            min-height: 1em;
        }

        .view-toggle {
            display: inline-flex;
            border: 1px solid var(--border-color);
            background: #000;
        }

        .toggle-btn {
            background: transparent;
            border: none;
            color: var(--text-muted);
            font-family: inherit;
            padding: 6px 10px;
            cursor: pointer;
        }

        .toggle-btn.active {
            background: var(--accent-color);
            color: #000;
            font-weight: bold;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
        }

        th {
            color: var(--text-muted);
            font-weight: normal;
            padding: 10px 5px;
            border-bottom: 1px solid var(--border-color);
        }

        td {
            padding: 10px 5px;
            border-bottom: 1px solid #222;
        }

        tr:hover td {
            background-color: #1a1a1a;
        }

        .static-row td {
            color: var(--accent-color);
            font-style: italic;
        }

        /* Search Highlight Row Style */
        tr.highlight-row td {
            background-color: rgba(189, 89, 255, 0.2);
            color: var(--highlight-color);
            font-weight: bold;
            border-bottom: 1px solid var(--highlight-color);
        }

        .omitted-row td {
            color: var(--text-muted);
            text-align: center;
            font-style: italic;
        }

        /* Footer */
        footer {
            margin-top: 50px;
            text-align: center;
            font-size: 0.9rem;
            color: var(--text-muted);
        }

        footer a {
            margin: 0 10px;
        }

        /* Modals */
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.8);
            z-index: 2000;
            justify-content: center;
            align-items: center;
        }

        .modal-content {
            background: var(--bg-color);
            border: 2px solid var(--accent-color);
            padding: 30px;
            max-width: 600px;
            width: 90%;
            max-height: 80vh;
            overflow-y: auto;
            position: relative;
        }

        .close-modal {
            position: absolute;
            top: 10px;
            right: 15px;
            font-size: 1.5rem;
            color: var(--accent-color);
            cursor: pointer;
        }

        /* --- RESPONSIVE --- */
        @@media (max-width: 1100px) {
            .logo-img {
                position: relative;
                display: block;
                margin: 0 auto 20px auto;
                top: 0;
                left: 0;
            }

            .charts-section {
                grid-template-columns: 1fr;
            }

            .list-toolbar {
                flex-direction: column;
                align-items: flex-start;
            }
        }
    </style>
</head>
<body>

<div class="dev-banner">
    ⚠️ DEVELOPER PREVIEW: EXPECT FREQUENT SERVER REBOOTS AND COPIUS BUGS ⚠️
</div>

<img src="logo.png" alt="Grid Labs" class="logo-img"/>

<div class="main-container">
    <h1>BOOT PROTOCOL</h1>

    <div class="search-section">
        <div class="search-box-container">
            <input type="text" id="search-input" class="search-input" placeholder="Enter Wallet Address..."
                   onkeypress="if(event.key === 'Enter') performSearch()">
            <button class="search-btn" onclick="performSearch()">SEARCH</button>
        </div>
        <div id="search-results" class="search-results"></div>
    </div>

    <div class="info-grid">
        <div class="info-box">
            <h3>🏆 All-Time Best Diff</h3>
            <div class="info-value accent-value" id="record-diff">0</div>
            <h3>Miner</h3>
            <div class="info-value" id="record-miner">None</div>
            <h3>Time (UTC)</h3>
            <div class="info-value" id="record-time">--</div>
        </div>

        <div class="info-box">
            <h3>📡 Connection Info</h3>
            <div>Host: <span class="accent-value" id="server-host">Loading...</span></div>
            <div>Port: <span class="accent-value" id="server-port">Loading...</span></div>
            <h3 style="margin-top: 10px;">Pool Pubkey</h3>
            <div class="key-container">
                <span id="server-pubkey-display">Loading...</span>
                <button onclick="copyPubKey()" class="copy-btn" title="Copy Key">📋</button>
            </div>
            <div id="copy-feedback" style="color: var(--accent-color); height: 15px; font-size: 0.7em;"></div>
        </div>

        <div class="info-box">
            <h3>🕸 Network State</h3>
            <div>Self: <span class="accent-value" id="self-endpoint">--</span></div>
            <div>Network: <span class="accent-value" id="network-id">Loading...</span></div>
            <div>Template Slots: <span class="accent-value" id="template-slot-count">Loading...</span></div>
            <div>Peers: <span class="accent-value" id="peer-count">0</span></div>
            <div>Current State: <span class="accent-value" id="current-state-id">Loading...</span></div>
            <div>Candidate State: <span class="accent-value" id="candidate-state-id">Loading...</span></div>
            <h3 style="margin-top: 10px;">Commitment Preview</h3>
            <div class="info-value" id="commitment-preview">Loading...</div>
            <div class="search-results" id="commitment-note"></div>
        </div>
    </div>

    <h2>Difficulty Distribution</h2>
    <div class="charts-section">
        <div class="chart-container">
            <canvas id="winnersChart"></canvas>
        </div>
        <div class="chart-container">
            <canvas id="onDeckChart"></canvas>
        </div>
    </div>

    <section>
        <h2>Peer Status</h2>
        <div class="table-container">
            <table id="peer-list">
                <thead>
                <tr>
                    <th>Endpoint</th>
                    <th>Status</th>
                    <th>Latency</th>
                    <th>Last Seen</th>
                </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </section>

    <div class="lists-container">
        <section>
            <h2>
                Current Winners List
                <span class="info-icon"
                      data-tooltip="High difficulty shares that won the last round.  Miners put these payouts in their coinbase transaction (including one spot for their own) to compete in the current round.">i</span>
            </h2>
            <div class="list-toolbar">
                <div class="list-summary-note" id="winners-summary-note"></div>
                <div class="view-toggle">
                    <button class="toggle-btn active" id="winners-summary-btn" onclick="setListViewMode('winners-list', 'summary')">SUMMARY</button>
                    <button class="toggle-btn" id="winners-full-btn" onclick="setListViewMode('winners-list', 'full')">FULL</button>
                </div>
            </div>
            <div class="table-container">
                <table id="winners-list">
                    <thead>
                    <tr>
                        <th>Address</th>
                        <th>Value (BTC)</th>
                        <th>Difficulty</th>
                    </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </section>

        <section style="margin-top: 30px;">
            <h2>
                On-Deck List
                <span class="info-icon"
                      data-tooltip="The current round of competition. When the team finds a new block, these addresses get locked into the Winners List.">i</span>
            </h2>
            <div class="list-toolbar">
                <div class="list-summary-note" id="ondeck-summary-note"></div>
                <div class="view-toggle">
                    <button class="toggle-btn active" id="ondeck-summary-btn" onclick="setListViewMode('ondeck-list', 'summary')">SUMMARY</button>
                    <button class="toggle-btn" id="ondeck-full-btn" onclick="setListViewMode('ondeck-list', 'full')">FULL</button>
                </div>
            </div>
            <div class="table-container">
                <table id="ondeck-list">
                    <thead>
                    <tr>
                        <th>Address</th>
                        <th>Value (BTC)</th>
                        <th>Difficulty</th>
                    </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </section>
    </div>

        <footer>
            <a href="https://github.com/gridlabs-science/boot-protocol" target="_blank">SOURCE CODE</a> |
            <a onclick="toggleModal('theory-modal')">THEORY</a> |
            <a onclick="toggleModal('help-modal')">HELP</a> |
            <a onclick="toggleModal('test-modal')">TEST TOOLS</a>
        </footer>
    </div> 

<div id="theory-modal" class="modal-overlay" onclick="if(event.target === this) toggleModal('theory-modal')">
    <div class="modal-content">
        <span class="close-modal" onclick="toggleModal('theory-modal')">&times;</span>
        <h2>Pool Theory</h2>
        <p>Boot Protocol operates differently than traditional pools. It's more like a protocol for solo miners to split
            rewards in exchange for better odds.</p>
        <p>Nodes maintain a "Winners List", which defines the 299 shared payout slots for the coinbase split. Slot 0 always belongs to the block finder, so a full template has 300 total payout slots.
            Miners make their own templates using this coinbase payout, and submit the highest difficulty shares to the
            nodes.
            Nodes keep track of top shares with the "On Deck List". Once someone finds a golden nonce and the Winner's
            List is paid on the Bitcoin blockchain,
            the "On Deck List" becomes the new Winner's List. </p>
        <p>This model has some interesting attributes. It should have scalable resistance to block withholding attacks,
            since a block withholding miner would usually hurt
            themselves more than the other miners. It is trivial to run decentralized, and bandwidth requirements
            between nodes are very small. It can be used by small
            lottery miners to increase their odds of a (smaller) jackpot, and by large pools to lower their variance in
            coordination with other pools while controlling their own templates.
            It doesn't have the centralization pressure caused by fast block times. </p>
        <p>We hope it will be a useful option for Bitcoin miners who value decentralization.</p>
    </div>
</div>

<div id="help-modal" class="modal-overlay" onclick="if(event.target === this) toggleModal('help-modal')">
    <div class="modal-content">
        <span class="close-modal" onclick="toggleModal('help-modal')">&times;</span>
        <h2>How to Connect</h2>
        <p>There are two options to join the Boot team and compete to get on the Winner's List:</p>
        <h3>The easy way (start with this):</h3>
        <p>1. Download the DATUM client.</p>
        <p>2. Configure your client with the host, port, and public key listed above.</p>
        <p>3. Start mining. Your highest difficulty shares will automatically be submitted.</p>
        <h3>The better way (after the above steps):</h3>
        <p>4. Go to the Boot Protocol repository and choose an installation method (bare metal or Docker)</p>
        <p>5. Start up the Boot Server, visit http://localhost:5000 and copy the public key</p>
        <p>6. Edit your DATUM Config to point towards your new Datum Server</p>
        <p>7. Get your friends to do the same!</p>
    </div>
</div>

<div id="test-modal" class="modal-overlay" onclick="if(event.target === this) toggleModal('test-modal')">
    <div class="modal-content">
        <span class="close-modal" onclick="toggleModal('test-modal')">&times;</span>
        <h2>Test Tools</h2>
        <p>Use this only for local testing. A reset locks the current On-Deck List into the Winners List and starts a fresh round.</p>
        <div class="search-box-container" style="margin-top: 20px;">
            <input type="password" id="admin-api-key" class="search-input" placeholder="Admin API Key">
            <button class="search-btn" onclick="triggerManualReset()">RESET LISTS</button>
        </div>
        <div id="admin-reset-status" class="search-results" style="margin-top: 12px;"></div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
<script>
    let fullServerPubKey = "";
    let winnersChartInstance = null;
    let onDeckChartInstance = null;
    let latestNetworkState = null;

    // Global state for client-side searching
    let globalWinnersList = [];
    let globalOnDeckList = [];
    let currentSearchTerm = "";
    const listViewModes = {
        "winners-list": "summary",
        "ondeck-list": "summary"
    };

    // --- INITIALIZE URL SEARCH ---
    // Checks if the URL is like /bc1q... and pre-fills the search
    window.addEventListener('DOMContentLoaded', () => {
        const path = window.location.pathname.substring(1); // Remove leading '/'
        // Simple check to ignore SignalR paths or empty paths
        if (path && path.length > 15 && !path.includes("/")) {
            const input = document.getElementById('search-input');
            input.value = path;
            currentSearchTerm = path; // Set immediate state
        }
    });

    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/poolStatsHub")
        .withAutomaticReconnect()
        .build();

    // --- SEARCH LOGIC ---
    function performSearch() {
        const input = document.getElementById('search-input');
        const rawTerm = input.value.trim();
        currentSearchTerm = rawTerm;
        const resultDiv = document.getElementById('search-results');

        if (!rawTerm) {
            resultDiv.innerHTML = "";
            refreshUI(); // Clear highlights
            return;
        }

        // 1. Scan Winners
        const winnerMatches = globalWinnersList
            .map((item, index) => ({item, index: index + 1})) // 1-based index
            .filter(x => x.item.username.toLowerCase().includes(rawTerm.toLowerCase()));

        const winnerTotal = winnerMatches.reduce((sum, x) => sum + x.item.value, 0);

        // 2. Scan OnDeck
        const deckMatches = globalOnDeckList
            .map((item, index) => ({item, index: index + 1}))
            .filter(x => x.item.username.toLowerCase().includes(rawTerm.toLowerCase()));

        const deckTotal = deckMatches.reduce((sum, x) => sum + x.item.value, 0);

        // 3. Build Output
        if (winnerMatches.length === 0 && deckMatches.length === 0) {
            resultDiv.innerHTML = `This address does not have any shares on the lists yet. Keep hashing!`;
        } else {
            let msg = "";
            if (deckMatches.length > 0) {
                const deckIndices = deckMatches.map(x => '#' + x.index).join(', ');
                const deckBtc = (deckTotal / 100000000.0).toFixed(8);
                msg += `<div><span class="result-highlight">On Deck List:</span> ${deckIndices}. Potential payout: ${deckBtc} BTC</div>`;
            }
            if (winnerMatches.length > 0) {
                const winIndices = winnerMatches.map(x => '#' + x.index).join(', ');
                const winBtc = (winnerTotal / 100000000.0).toFixed(8);
                msg += `<div><span class="result-highlight">Winners List:</span> ${winIndices}. Locked payout: ${winBtc} BTC</div>`;
            }
            resultDiv.innerHTML = msg;
        }

        // 4. Trigger UI Redraw to show highlights
        refreshUI();
    }

    function refreshUI() {
        updateTable("winners-list", globalWinnersList);
        updateTable("ondeck-list", globalOnDeckList);

        // Re-draw charts with the vertical lines
        winnersChartInstance = updateChart("winnersChart", globalWinnersList, "Winners List Depth", winnersChartInstance);
        onDeckChartInstance = updateChart("onDeckChart", globalOnDeckList, "On-Deck List Depth", onDeckChartInstance);
    }


    // --- STANDARD HELPERS ---
    function formatAddress(address) {
        if (!address) return "Unknown";
        const dotIndex = address.indexOf('.');
        let mainPart = address;
        let suffix = "";
        if (dotIndex !== -1) {
            mainPart = address.substring(0, dotIndex);
            suffix = address.substring(dotIndex);
        }
        if (mainPart.length <= 12) return address;
        const first6 = mainPart.substring(0, 6);
        const last6 = mainPart.substring(mainPart.length - 6);
        return `${first6}...${last6}${suffix}`;
    }

    function copyPubKey() {
        if (!fullServerPubKey) return;
        navigator.clipboard.writeText(fullServerPubKey).then(() => {
            const feedback = document.getElementById("copy-feedback");
            feedback.innerText = "COPIED!";
            setTimeout(() => feedback.innerText = "", 2000);
        });
    }

    function shortenHash(value) {
        if (!value) return "--";
        if (value.length <= 18) return value;
        return `${value.substring(0, 8)}...${value.substring(value.length - 8)}`;
    }

    function toggleModal(modalId) {
        const modal = document.getElementById(modalId);
        modal.style.display = modal.style.display === 'flex' ? 'none' : 'flex';
    }

    function setListViewMode(tableId, mode) {
        listViewModes[tableId] = mode;
        refreshUI();
    }

    function renderPeerTable(peers) {
        const tableBody = document.querySelector('#peer-list tbody');
        tableBody.innerHTML = '';

        if (!peers || peers.length === 0) {
            tableBody.innerHTML = '<tr><td colspan="4">No peers connected yet.</td></tr>';
            return;
        }

        peers.forEach(peer => {
            const latency = peer.latencyMs == null ? '--' : `${peer.latencyMs.toFixed(0)} ms`;
            const lastSeen = peer.lastSeenUtc ? new Date(peer.lastSeenUtc).toLocaleString() : '--';
            const row = `<tr>
                    <td title="${peer.endpoint}">${peer.endpoint}</td>
                    <td>${peer.status || '--'}</td>
                    <td>${latency}</td>
                    <td>${lastSeen}</td>
                </tr>`;
            tableBody.innerHTML += row;
        });
    }

    async function triggerManualReset() {
        const status = document.getElementById('admin-reset-status');
        const apiKey = document.getElementById('admin-api-key').value.trim();

        if (!apiKey) {
            status.innerText = "Enter the admin API key first.";
            return;
        }

        status.innerText = "Resetting round...";

        try {
            const response = await fetch('/api/network/admin/reset', {
                method: 'POST',
                headers: {
                    'X-Boot-Admin-Key': apiKey
                }
            });

            const payload = await response.json().catch(() => null);
            if (!response.ok) {
                status.innerText = payload?.reason || 'Reset failed.';
                return;
            }

            status.innerText = `Reset complete. New state: ${shortenHash(payload?.networkStatus?.currentStateId || payload?.lockedStateBundle?.stateId || '')}`;
        } catch (error) {
            console.error(error);
            status.innerText = 'Reset request failed.';
        }
    }

    function getDisplayRows(tableId, list) {
        const normalizedList = list || [];
        if (currentSearchTerm || listViewModes[tableId] !== 'summary' || normalizedList.length <= 12) {
            return {
                rows: normalizedList,
                summarized: false,
                omittedCount: 0
            };
        }

        const headCount = 5;
        const tailCount = 5;
        const head = normalizedList.slice(0, headCount);
        const tailStart = Math.max(head.length, normalizedList.length - tailCount);
        const tail = normalizedList.slice(tailStart);
        const omittedCount = Math.max(0, normalizedList.length - head.length - tail.length);
        const rows = [...head];

        if (omittedCount > 0) {
            rows.push({ __omitted: true, omittedCount: omittedCount });
        }

        rows.push(...tail);
        return {
            rows: rows,
            summarized: omittedCount > 0,
            omittedCount: omittedCount
        };
    }

    function updateListSummary(tableId, list, displayMeta) {
        const prefix = tableId === "winners-list" ? "winners" : "ondeck";
        document.getElementById(`${prefix}-summary-btn`).classList.toggle('active', listViewModes[tableId] === 'summary');
        document.getElementById(`${prefix}-full-btn`).classList.toggle('active', listViewModes[tableId] === 'full');

        const note = document.getElementById(`${prefix}-summary-note`);
        const total = (list || []).length;
        const slotLabel = tableId === "winners-list" ? "shared slots plus slot 0" : "shared slots";

        if (currentSearchTerm) {
            note.innerText = `Search active. Showing all ${total} ${slotLabel}.`;
            return;
        }

        if (total === 0) {
            note.innerText = 'No qualifying entries yet.';
            return;
        }

        if (displayMeta.summarized) {
            note.innerText = `Showing top 5 and bottom 5 of ${total} ${slotLabel}.`;
            return;
        }

        note.innerText = `Showing all ${total} ${slotLabel}.`;
    }

    function updateTable(tableId, list) {
        const tableBody = document.querySelector(`#${tableId} tbody`);
        tableBody.innerHTML = '';
        const displayMeta = getDisplayRows(tableId, list);
        updateListSummary(tableId, list, displayMeta);

        if (tableId === "winners-list") {
            tableBody.innerHTML += `<tr class="static-row"><td>[YourAddressHere]</td><td>1 share + fees</td><td>>NetworkDiff</td></tr>`;
        }

        if (!list) return;

        displayMeta.rows.forEach(payout => {
            if (payout.__omitted) {
                tableBody.innerHTML += `<tr class="omitted-row"><td colspan="3">${payout.omittedCount} additional shared slots hidden</td></tr>`;
                return;
            }

            const btcValue = payout.value / 100000000.0;
            const formattedAddr = formatAddress(payout.username);
            const diffVal = payout.difficulty || 0;
            const diffDisplay = payout.diffString || diffVal.toLocaleString(undefined, {maximumFractionDigits: 2});

            // CHECK FOR SEARCH HIGHLIGHT
            let rowClass = "";
            if (currentSearchTerm && payout.username.toLowerCase().includes(currentSearchTerm.toLowerCase())) {
                rowClass = "highlight-row";
            }

            const row = `<tr class="${rowClass}">
                    <td title="${payout.address}">${formattedAddr}</td>
                    <td>${btcValue.toFixed(8)}</td>
                    <td>${diffDisplay}</td>
                </tr>`;
            tableBody.innerHTML += row;
        });
    }

    // --- CHART LOGIC WITH VERTICAL LINES ---

    function updateChart(canvasId, list, chartTitle, chartInstanceRef) {
        const ctx = document.getElementById(canvasId).getContext('2d');
        const plotData = list.map(x => x.difficulty).reverse();
        const labels = list.map((_, index) => list.length - index);

        //const bubbleData = currentSearchTerm && list.find(x => x.address === currentSearchTerm) ?
        //    list.sort((a, b) => a.difficulty - b.difficulty).map(x => x.address === currentSearchTerm ? x.difficulty : NaN) : [];
        
        // FIX: Use [...list] to create a shallow copy before sorting
        const bubbleData = currentSearchTerm && list.find(x => x.username.toLowerCase().includes(currentSearchTerm.toLowerCase())) ?
            [...list].sort((a, b) => a.difficulty - b.difficulty).map(x => x.username.toLowerCase().includes(currentSearchTerm.toLowerCase()) ? x.difficulty : NaN) : [];

        const accentColor = getComputedStyle(document.documentElement).getPropertyValue('--accent-color').trim();

        const datasets = [{
            label: 'Difficulty',
            data: plotData,
            borderColor: accentColor,
            backgroundColor: accentColor + '33',
            borderWidth: 2,
            pointRadius: 0, // Hide points normally
            pointHoverRadius: 4,
            fill: true,
            tension: 0.2
        }];

        if (bubbleData.length > 0) {
            datasets.push({
                label: 'Your Difficulty',
                type: 'bubble',
                data: bubbleData,
                borderColor: '#fff',
                backgroundColor: '#fff',
                borderWidth: 2,
                pointRadius: 5,
                pointHoverRadius: 8,
                fill: false,
            });
        }

        if (chartInstanceRef) chartInstanceRef.destroy();

        // We attach the raw list to the config so the plugin can read it
        const newChart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: datasets
            },
            _rawList: list, // Custom property to pass data to plugin
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: {
                    mode: 'index',
                    intersect: false,
                },
                plugins: {
                    legend: {display: false},
                    title: {display: true, text: chartTitle, color: '#888'},
                    tooltip: {
                        callbacks: {
                            label: function (context) {
                                return `Diff: ${context.raw.toLocaleString()}`;
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        grid: {color: '#333', drawBorder: false},
                        ticks: {
                            color: '#888', callback: function (value) {
                                if (value > 1000000) return (value / 1000000).toFixed(1) + 'M';
                                if (value > 1000) return (value / 1000).toFixed(0) + 'K';
                                return value;
                            }
                        }
                    },
                    x: {grid: {display: false}, ticks: {display: false}}
                }
            }
        });
        return newChart;
    }

    // --- SIGNALR HANDLERS ---

    connection.on("UpdateWinners", (list) => {
        globalWinnersList = list || [];
        // If a search is active, this will redraw with highlights
        if (currentSearchTerm) {
            performSearch();
        } else {
            refreshUI();
        }
    });

    connection.on("UpdateOnDeck", (list) => {
        globalOnDeckList = list || [];
        if (currentSearchTerm) {
            performSearch();
        } else {
            refreshUI();
        }
    });

    connection.on("UpdateRecord", (record) => {
        if (record) {
            document.getElementById("record-diff").innerText = record.difficulty.toLocaleString(undefined, {maximumFractionDigits: 2});
            document.getElementById("record-miner").innerText = formatAddress(record.minerAddress);
            document.getElementById("record-time").innerText = record.timestamp ? new Date(record.timestamp).toLocaleString() : "--";
        }
    });

    connection.on("UpdateServerInfo", (info) => {
        fullServerPubKey = info.pubKey;
        document.getElementById("server-host").innerText = info.datumHost || "--";
        document.getElementById("server-port").innerText = info.poolPort;
        if (info.pubKey && info.pubKey.length > 16) {
            const first = info.pubKey.substring(0, 8);
            const last = info.pubKey.substring(info.pubKey.length - 8);
            document.getElementById("server-pubkey-display").innerText = `${first}...${last}`;
        } else {
            document.getElementById("server-pubkey-display").innerText = info.pubKey;
        }
    });

    connection.on("UpdateNetworkState", (state) => {
        if (!state) return;
        latestNetworkState = state;
        document.getElementById("self-endpoint").innerText = state.selfEndpoint || "--";
        document.getElementById("network-id").innerText = state.networkId || "--";
        document.getElementById("template-slot-count").innerText = `${state.totalPayoutSlotCount ?? '--'} total (${state.sharedWinnerSlotCount ?? '--'} shared + slot 0)`;
        document.getElementById("peer-count").innerText = state.peerCount ?? 0;
        document.getElementById("current-state-id").innerText = shortenHash(state.currentStateId);
        document.getElementById("candidate-state-id").innerText = shortenHash(state.candidateStateId);
        document.getElementById("commitment-preview").innerText = state.commitment?.tagPreview || "--";
        document.getElementById("commitment-note").innerText = state.commitment?.supportNote || "";
        renderPeerTable(state.peers || []);
    });

    async function start() {
        try {
            await connection.start();
            await connection.invoke("GetInitialData");
        } catch (err) {
            console.error(err);
            setTimeout(start, 5000);
        }
    };

    start();
</script>
</body>
</html>
