    function updateRoundShareChart(history) {
        const canvas = document.getElementById("roundShareChart");
        const note = document.getElementById("round-history-search-note");
        const ctx = canvas.getContext("2d");

        if (roundShareChartInstance) {
            roundShareChartInstance.destroy();
            roundShareChartInstance = null;
        }

        if (!history || history.length === 0) {
            note.innerText = "";
            return;
        }

        const displayHistory = roundHistoryDisplayOrder(history);
        const totalsByAddress = new Map();
        displayHistory.forEach(entry => {
            (entry.paidRecipients || []).forEach(recipient => {
                const key = recipient.address || recipient.username || "unknown";
                totalsByAddress.set(key, (totalsByAddress.get(key) || 0) + (recipient.totalValue || 0));
            });
        });

        const topAddresses = [...totalsByAddress.entries()]
            .sort((a, b) => b[1] - a[1])
            .slice(0, 4)
            .map(entry => entry[0]);

        const labels = displayHistory.map(entry => `R${entry.roundNumber}`);
        const colors = ["#bd59ff", "#39d98a", "#ffc857", "#4ea8de", "#666666"];
        const datasets = topAddresses.map((address, index) => ({
            label: formatAddress(address),
            data: displayHistory.map(entry => {
                const total = entry.paidTotalValue || 0;
                const match = (entry.paidRecipients || []).find(item => item.address === address);
                return total ? (((match?.totalValue || 0) / total) * 100) : 0;
            }),
            backgroundColor: colors[index % colors.length]
        }));

        const hasOther = displayHistory.some(entry => {
            const totalKnown = (entry.paidRecipients || [])
                .filter(item => topAddresses.includes(item.address))
                .reduce((sum, item) => sum + (item.totalValue || 0), 0);
            return totalKnown < (entry.paidTotalValue || 0);
        });

        if (hasOther) {
            datasets.push({
                label: "Other",
                data: displayHistory.map(entry => {
                    const total = entry.paidTotalValue || 0;
                    const totalKnown = (entry.paidRecipients || [])
                        .filter(item => topAddresses.includes(item.address))
                        .reduce((sum, item) => sum + (item.totalValue || 0), 0);
                    return total ? (((total - totalKnown) / total) * 100) : 0;
                }),
                backgroundColor: colors[4]
            });
        }

        roundShareChartInstance = new Chart(ctx, {
            type: "bar",
            data: {
                labels: labels,
                datasets: datasets
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: "bottom",
                        labels: {
                            color: "#888"
                        }
                    },
                    title: {
                        display: true,
                        text: "Paid Share By Address Across Recent Rounds",
                        color: "#888"
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return `${context.dataset.label}: ${context.raw.toFixed(1)}%`;
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        stacked: true,
                        ticks: { color: "#888" },
                        grid: { display: false }
                    },
                    y: {
                        stacked: true,
                        beginAtZero: true,
                        max: 100,
                        ticks: {
                            color: "#888",
                            callback: function(value) {
                                return `${value}%`;
                            }
                        },
                        grid: { color: "#333", drawBorder: false }
                    }
                }
            }
        });

        if (currentSearchValue()) {
            const avgPaidShare = displayHistory.reduce((sum, entry) => {
                const share = computeRecipientShare(entry.paidRecipients, entry.paidTotalValue);
                return sum + (share ? share.percent : 0);
            }, 0) / displayHistory.length;
            note.innerText = `Search match average paid share across these rounds: ${avgPaidShare.toFixed(1)}%.`;
        } else {
            note.innerText = "Use the search box to see a per-round share percentage for a specific address.";
        }
    }

    function copyPubKey() {
        if (!fullServerPubKey) return;
        navigator.clipboard.writeText(fullServerPubKey).then(() => {
            const feedback = document.getElementById("copy-feedback");
            feedback.innerText = "COPIED!";
            setTimeout(() => feedback.innerText = "", 2000);
        });
    }

    function shortenHash(value) {
        if (!value) return "--";
        if (value.length <= 18) return value;
        return `${value.substring(0, 8)}...${value.substring(value.length - 8)}`;
    }

    function toggleModal(modalId) {
        const modal = document.getElementById(modalId);
        modal.style.display = modal.style.display === 'flex' ? 'none' : 'flex';
    }

    function setListViewMode(tableId, mode) {
        listViewModes[tableId] = mode;
        refreshUI();
    }

    function renderPeerTable(peers) {
        const tableBody = document.querySelector('#peer-list tbody');
        tableBody.innerHTML = '';

        if (!peers || peers.length === 0) {
            tableBody.innerHTML = '<tr><td colspan="4">No peers connected yet.</td></tr>';
            return;
        }

        peers.forEach(peer => {
            const latency = peer.latencyMs == null ? '--' : `${peer.latencyMs.toFixed(0)} ms`;
            const lastSeen = peer.lastSeenUtc ? new Date(peer.lastSeenUtc).toLocaleString() : '--';
            const row = `<tr>
                    <td title="${peer.endpoint}">${peer.endpoint}</td>
                    <td>${peer.status || '--'}</td>
                    <td>${latency}</td>
                    <td>${lastSeen}</td>
                </tr>`;
            tableBody.innerHTML += row;
        });
    }

    async function triggerManualReset() {
        const status = document.getElementById('admin-reset-status');
        const apiKey = document.getElementById('admin-api-key').value.trim();

        if (!apiKey) {
            status.innerText = "Enter the admin API key first.";
            return;
        }

        status.innerText = "Resetting round...";

        try {
            const response = await fetch('/api/network/admin/reset', {
                method: 'POST',
                headers: {
                    'X-Boot-Admin-Key': apiKey
                }
            });

            const payload = await response.json().catch(() => null);
            if (!response.ok) {
                status.innerText = payload?.reason || 'Reset failed.';
                return;
            }

            status.innerText = `Reset complete. New state: ${shortenHash(payload?.networkStatus?.currentStateId || payload?.lockedStateBundle?.stateId || '')}`;
        } catch (error) {
            console.error(error);
            status.innerText = 'Reset request failed.';
        }
    }

    function getDisplayRows(tableId, list) {
        const normalizedList = list || [];
        if (currentSearchTerm || listViewModes[tableId] !== 'summary' || normalizedList.length <= 12) {
            return {
                rows: normalizedList,
                summarized: false,
                omittedCount: 0
            };
        }

        const headCount = 5;
        const tailCount = 5;
        const head = normalizedList.slice(0, headCount);
        const tailStart = Math.max(head.length, normalizedList.length - tailCount);
        const tail = normalizedList.slice(tailStart);
        const omittedCount = Math.max(0, normalizedList.length - head.length - tail.length);
        const rows = [...head];

        if (omittedCount > 0) {
            rows.push({ __omitted: true, omittedCount: omittedCount });
        }

        rows.push(...tail);
        return {
            rows: rows,
            summarized: omittedCount > 0,
            omittedCount: omittedCount
        };
    }

    function updateListSummary(tableId, list, displayMeta) {
        const prefix = tableId === "winners-list" ? "winners" : "ondeck";
        document.getElementById(`${prefix}-summary-btn`).classList.toggle('active', listViewModes[tableId] === 'summary');
        document.getElementById(`${prefix}-full-btn`).classList.toggle('active', listViewModes[tableId] === 'full');

        const note = document.getElementById(`${prefix}-summary-note`);
        const total = (list || []).length;
        const slotLabel = tableId === "winners-list" ? "shared slots plus slot 0" : "shared slots";

        if (currentSearchTerm) {
            note.innerText = `Search active. Showing all ${total} ${slotLabel}.`;
            return;
        }

        if (total === 0) {
            note.innerText = 'No qualifying entries yet.';
            return;
        }

        if (displayMeta.summarized) {
            note.innerText = `Showing top 5 and bottom 5 of ${total} ${slotLabel}.`;
            return;
        }

        note.innerText = `Showing all ${total} ${slotLabel}.`;
    }

    function updateTable(tableId, list) {
        const tableBody = document.querySelector(`#${tableId} tbody`);
        tableBody.innerHTML = '';
        const displayMeta = getDisplayRows(tableId, list);
        updateListSummary(tableId, list, displayMeta);

        if (tableId === "winners-list") {
            tableBody.innerHTML += `<tr class="static-row"><td>[YourAddressHere]</td><td>1 share + fees</td><td>>NetworkDiff</td></tr>`;
        }

        if (!list) return;

        displayMeta.rows.forEach(payout => {
            if (payout.__omitted) {
                tableBody.innerHTML += `<tr class="omitted-row"><td colspan="3">${payout.omittedCount} additional shared slots hidden</td></tr>`;
                return;
            }

            const btcValue = payout.value / 100000000.0;
            const formattedAddr = formatAddress(payout.username);
            const diffVal = payout.difficulty || 0;
            const diffDisplay = payout.diffString || diffVal.toLocaleString(undefined, {maximumFractionDigits: 2});

            // CHECK FOR SEARCH HIGHLIGHT
            let rowClass = "";
            if (currentSearchTerm && payout.username.toLowerCase().includes(currentSearchTerm.toLowerCase())) {
                rowClass = "highlight-row";
            }

            const row = `<tr class="${rowClass}">
                    <td title="${payout.address}">${formattedAddr}</td>
                    <td>${btcValue.toFixed(8)}</td>
                    <td>${diffDisplay}</td>
                </tr>`;
            tableBody.innerHTML += row;
        });
    }

    // --- CHART LOGIC WITH VERTICAL LINES ---

    function updateChart(canvasId, list, chartTitle, chartInstanceRef) {
        const ctx = document.getElementById(canvasId).getContext('2d');
        const plotData = list.map(x => x.difficulty).reverse();
        const labels = list.map((_, index) => list.length - index);

        //const bubbleData = currentSearchTerm && list.find(x => x.address === currentSearchTerm) ?
        //    list.sort((a, b) => a.difficulty - b.difficulty).map(x => x.address === currentSearchTerm ? x.difficulty : NaN) : [];
        
        // FIX: Use [...list] to create a shallow copy before sorting
        const bubbleData = currentSearchTerm && list.find(x => x.username.toLowerCase().includes(currentSearchTerm.toLowerCase())) ?
            [...list].sort((a, b) => a.difficulty - b.difficulty).map(x => x.username.toLowerCase().includes(currentSearchTerm.toLowerCase()) ? x.difficulty : NaN) : [];

        const accentColor = getComputedStyle(document.documentElement).getPropertyValue('--accent-color').trim();

        const datasets = [{
            label: 'Difficulty',
            data: plotData,
            borderColor: accentColor,
            backgroundColor: accentColor + '33',
            borderWidth: 2,
            pointRadius: 0, // Hide points normally
            pointHoverRadius: 4,
            fill: true,
            tension: 0.2
        }];

        if (bubbleData.length > 0) {
            datasets.push({
                label: 'Your Difficulty',
                type: 'bubble',
                data: bubbleData,
                borderColor: '#fff',
                backgroundColor: '#fff',
                borderWidth: 2,
                pointRadius: 5,
                pointHoverRadius: 8,
                fill: false,
            });
        }

        if (chartInstanceRef) chartInstanceRef.destroy();

        // We attach the raw list to the config so the plugin can read it
        const newChart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: datasets
            },
            _rawList: list, // Custom property to pass data to plugin
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: {
                    mode: 'index',
                    intersect: false,
                },
                plugins: {
                    legend: {display: false},
                    title: {display: true, text: chartTitle, color: '#888'},
                    tooltip: {
                        callbacks: {
                            label: function (context) {
                                return `Diff: ${context.raw.toLocaleString()}`;
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        grid: {color: '#333', drawBorder: false},
                        ticks: {
                            color: '#888', callback: function (value) {
                                if (value > 1000000) return (value / 1000000).toFixed(1) + 'M';
                                if (value > 1000) return (value / 1000).toFixed(0) + 'K';
                                return value;
                            }
                        }
                    },
                    x: {grid: {display: false}, ticks: {display: false}}
                }
            }
        });
        return newChart;
    }

    // --- SIGNALR HANDLERS ---

    connection.on("UpdateWinners", (list) => {
        globalWinnersList = list || [];
        // If a search is active, this will redraw with highlights
        if (currentSearchTerm) {
            performSearch();
        } else {
            refreshUI();
        }
    });

    connection.on("UpdateOnDeck", (list) => {
        globalOnDeckList = list || [];
        if (currentSearchTerm) {
            performSearch();
        } else {
            refreshUI();
        }
    });

    connection.on("UpdateRecord", (record) => {
        if (record) {
            document.getElementById("record-diff").innerText = record.difficulty.toLocaleString(undefined, {maximumFractionDigits: 2});
            document.getElementById("record-miner").innerText = formatAddress(record.minerAddress);
            document.getElementById("record-time").innerText = record.timestamp ? new Date(record.timestamp).toLocaleString() : "--";
        }
    });

    connection.on("UpdateRoundHistory", (history) => {
        globalRoundHistory = history || [];
        renderRoundHistory(globalRoundHistory);
    });

    connection.on("UpdateServerInfo", (info) => {
        fullServerPubKey = info.pubKey;
        document.getElementById("server-host").innerText = info.datumHost || "--";
        document.getElementById("server-port").innerText = info.poolPort;
        if (info.pubKey && info.pubKey.length > 16) {
            const first = info.pubKey.substring(0, 8);
            const last = info.pubKey.substring(info.pubKey.length - 8);
            document.getElementById("server-pubkey-display").innerText = `${first}...${last}`;
        } else {
            document.getElementById("server-pubkey-display").innerText = info.pubKey;
        }
    });

    connection.on("UpdateNetworkState", (state) => {
        if (!state) return;
        latestNetworkState = state;
        document.getElementById("self-endpoint").innerText = state.selfEndpoint || "--";
        document.getElementById("network-id").innerText = state.networkId || "--";
        document.getElementById("template-slot-count").innerText = `${state.totalPayoutSlotCount ?? '--'} total (${state.sharedWinnerSlotCount ?? '--'} shared + slot 0)`;
        document.getElementById("peer-count").innerText = state.peerCount ?? 0;
        document.getElementById("current-state-id").innerText = shortenHash(state.currentStateId);
        document.getElementById("candidate-state-id").innerText = shortenHash(state.candidateStateId);
        document.getElementById("testing-trigger-status").innerText = state.testingRoundResetEnabled ? "ACTIVE" : "disabled";
        document.getElementById("last-testing-trigger-block").innerText = state.lastTestingTriggerBlockHash
            ? formatBlockLabel(state.lastTestingTriggerBlockHash, state.lastTestingTriggerBlockHeight)
            : "--";
        document.getElementById("commitment-preview").innerText = state.commitment?.tagPreview || "--";
        document.getElementById("commitment-note").innerText = state.commitment?.supportNote || "";
        document.getElementById("testing-trigger-note").innerText = state.testingRoundResetDescription || "";
        renderPeerTable(state.peers || []);
    });

    async function start() {
        try {
            await connection.start();
            await connection.invoke("GetInitialData");
        } catch (err) {
            console.error(err);
            setTimeout(start, 5000);
        }
    };

    start();
</script>
</body>
</html>
