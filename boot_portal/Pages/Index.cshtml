                    <h3>Locked At</h3>
                    <div class="round-detail-value">${formatTimestamp(entry.lockedAtUtc)}</div>
                </div>
                <div class="round-detail-box">
                    <h3>Winning Difficulty</h3>
                    <div class="round-detail-value">${entry.winningTotalDifficultyDisplay || "--"} across ${entry.winningShareCount} shares</div>
                </div>
                <div class="round-detail-box">
                    <h3>Paid This Block</h3>
                    <div class="round-detail-value">${entry.paidRecipientCount} recipients across ${entry.paidSlotCount} shared slots</div>
