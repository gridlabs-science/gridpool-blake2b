[Unit]
Description=Check GridPool Blake2b mainnet node health
After=gridpool-blake2b-knots-mainnet.service
Requires=gridpool-blake2b-knots-mainnet.service

[Service]
Type=oneshot
User=bitcoin
Group=bitcoin
ExecStart=/usr/local/sbin/check-gridpool-blake2b-knots-mainnet
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
