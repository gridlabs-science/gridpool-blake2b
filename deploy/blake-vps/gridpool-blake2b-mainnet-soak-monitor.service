[Unit]
Description=GridPool Blake2b mainnet 12-hour private soak monitor
After=network-online.target gridpool-blake2b-mainnet-private-soak.service gridpool-blake2b-datum-mainnet-private-soak.service
Wants=network-online.target
Requires=gridpool-blake2b-mainnet-private-soak.service gridpool-blake2b-datum-mainnet-private-soak.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/gridpool-blake2b/mainnet-private-soak
Environment=BOOT_G2_MAIN_URL=http://127.0.0.1:5000
Environment=BOOT_G2_PEER_URL=
Environment=BOOT_G2_INTERVAL_SECONDS=5
Environment=BOOT_G2_LOG_DIR=/opt/gridpool-blake2b/mainnet-private-soak/soak-logs
ExecStart=/opt/gridpool-blake2b/mainnet-private-soak/scripts/boot-g2-soak.sh 12h /opt/gridpool-blake2b/mainnet-private-soak/soak-logs/private-soak.json
Restart=no

[Install]
WantedBy=multi-user.target
