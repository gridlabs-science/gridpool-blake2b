[Unit]
Description=Check GridPool Blake2b Testnet4 node health
After=gridpool-blake2b-knots-testnet4.service

[Service]
Type=oneshot
User=bitcoin
Group=bitcoin
ExecStart=/usr/local/sbin/check-gridpool-blake2b-knots-testnet4
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
