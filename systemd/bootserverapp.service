[Unit]
Description=Boot Protocol Server
Wants=network-online.target
After=network-online.target

[Service]
User=__GRIDPOOL_SERVICE_USER__
WorkingDirectory=__GRIDPOOL_PUBLISH_DIR__
ExecStart=/usr/bin/dotnet __GRIDPOOL_PUBLISH_DIR__/boot_portal.dll
Restart=always
RestartSec=10
TimeoutStopSec=20
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=BOOT_PORTAL_CONFIG_PATH=__GRIDPOOL_CONFIG_PATH__
Environment=BOOT_PORTAL_STATE_PATH=__GRIDPOOL_STATE_PATH__

[Install]
WantedBy=multi-user.target
