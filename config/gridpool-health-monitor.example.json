{
  "monitorName": "gridpool-public-beta",
  "timezone": "America/New_York",
  "requestTimeoutMs": 8000,
  "alertCooldownMinutes": 60,
  "codexCooldownMinutes": 360,
  "morningDigest": {
    "enabled": true,
    "hourLocal": 7
  },
  "telegram": {
    "enabled": true,
    "botTokenEnv": "TELEGRAM_BOT_TOKEN",
    "allowedChatIdsEnv": "TELEGRAM_ALLOWED_CHAT_IDS",
    "commandChatIdsEnv": "TELEGRAM_COMMAND_CHAT_IDS"
  },
  "codex": {
    "enabled": false,
    "repoDir": "/home/keegreil/Documents/GitHub/boot-protocol",
    "timeoutSeconds": 600,
    "model": "",
    "resumeArgs": [
      "exec",
      "-C",
      "/home/keegreil/Documents/GitHub/boot-protocol",
      "--sandbox",
      "read-only",
      "--ask-for-approval",
      "never",
      "resume",
      "--last"
    ]
  },
  "thresholds": {
    "endpointFailureConsecutive": 2,
    "consensusDivergenceConsecutive": 2,
    "candidateDivergenceConsecutive": 3,
    "candidateDivergenceMinimumMinutes": 10,
    "datumRejectRateMax": 0.1,
    "datumRejectRateMinSubmissions": 25,
    "hashrateDropFraction": 0.35,
    "hashrateSpikeMultiplier": 2.0,
    "hashrateSamplesForTrend": 3,
    "minimumHashrateThsForTrend": 1,
    "activeHydrapoolWorkerMaxAgeMinutes": 60
  },
  "nodes": [
    {
      "name": "main",
      "baseUrl": "https://main.gridpool.net",
      "critical": true,
      "consensusGroup": "mainnet-beta",
      "minimumPeerCount": 1
    },
    {
      "name": "testnet4",
      "baseUrl": "https://test.gridpool.net",
      "critical": false,
      "consensusGroup": "testnet4-beta",
      "minimumPeerCount": 0,
      "suppressCoinbaseModeAlert": true,
      "suppressTeamHashrateAlerts": true,
      "suppressLocalDatumHashrateAlerts": true
    },
    {
      "name": "evomining",
      "baseUrl": "http://evomining.farted.net",
      "critical": false,
      "consensusGroup": "mainnet-beta",
      "minimumPeerCount": 1
    },
    {
      "name": "dallas",
      "baseUrl": "https://dallas.gridpool.net",
      "critical": false,
      "consensusGroup": "mainnet-beta",
      "minimumPeerCount": 1
    }
  ],
  "tcpEndpoints": [
    {
      "name": "datum-main",
      "host": "datum.main.gridpool.net",
      "port": 3008,
      "critical": true
    },
    {
      "name": "datum-testnet4",
      "host": "datum.test.gridpool.net",
      "port": 3009,
      "critical": false
    },
    {
      "name": "datum-dallas",
      "host": "datum.dallas.gridpool.net",
      "port": 3008,
      "critical": false
    }
  ],
  "hydrapools": [
    {
      "name": "main-hydrapool",
      "baseUrl": "http://127.0.0.1:46884",
      "critical": false,
      "usernameEnv": "HYDRAPOOL_API_USER",
      "passwordEnv": "HYDRAPOOL_API_PASSWORD",
      "defaultUsername": "hydrapool",
      "defaultPassword": "hydrapool"
    }
  ],
  "services": [
    {
      "name": "bootserverapp.service",
      "critical": true
    },
    {
      "name": "hydrapool-gridpool.service",
      "critical": false
    },
    {
      "name": "cloudflared.service",
      "critical": true
    },
    {
      "name": "docker.service",
      "critical": false
    }
  ],
  "knownAddresses": [
    {
      "address": "bc1qce93hy5rhg02s6aeu7mfdvxg76x66pqqtrvzs3",
      "label": "256 Foundation genesis/default payout"
    },
    {
      "address": "bc1qrwsx8fs0l6z7ugp5cvzy6lhss7jlyru3kg9s8y",
      "label": "Grid Labs main address"
    }
  ]
}
